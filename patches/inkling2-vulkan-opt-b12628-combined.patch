+static bool ggml_vk_can_fuse_ssm_conv_res_scale(const ggml_backend_vk_context * ctx, const struct ggml_cgraph * cgraph, int node_idx) {
+    const ggml_tensor * conv    = cgraph->nodes[node_idx + 0];
+    const ggml_tensor * reshape = cgraph->nodes[node_idx + 1];
+    const ggml_tensor * add     = cgraph->nodes[node_idx + 2];
+    const ggml_tensor * scale   = cgraph->nodes[node_idx + 3];
+
+    if (add->src[0] != reshape && add->src[1] != reshape) {
+        return false;
+    }
+    const ggml_tensor * res = (add->src[0] == reshape) ? add->src[1] : add->src[0];
+    if (conv->type != GGML_TYPE_F32 || conv->src[0]->type != GGML_TYPE_F32 || conv->src[1]->type != GGML_TYPE_F32 ||
+        res->type != GGML_TYPE_F32 || scale->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous(reshape) || !ggml_is_contiguous(res) || !ggml_is_contiguous(scale) ||
+        !ggml_are_same_shape(res, add) || !ggml_are_same_shape(add, scale) ||
+        ggml_get_op_params_f32(scale, 1) != 0.0f ||
+        get_misalign_bytes(ctx, conv->src[0]) != 0 || get_misalign_bytes(ctx, conv->src[1]) != 0 ||
+        get_misalign_bytes(ctx, res) != 0 || get_misalign_bytes(ctx, scale) != 0) {
+        return false;
+    }
+    return true;
+}
