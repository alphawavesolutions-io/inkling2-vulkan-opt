+static bool ggml_vk_can_fuse_ssm_conv_decode(const ggml_backend_vk_context * ctx, const struct ggml_cgraph * cgraph, int node_idx, bool has_dyn) {
+    vk_pipeline pipe = has_dyn ? ctx->device->pipeline_ssm_conv_decode_dyn_f32 : ctx->device->pipeline_ssm_conv_decode_f32;
+    if (!pipe) {
+        return false;
+    }
+    const ggml_tensor * concat    = cgraph->nodes[node_idx + 0];
+    const ggml_tensor * view_last = cgraph->nodes[node_idx + 1];
+    const ggml_tensor * cpy       = cgraph->nodes[node_idx + 2];
+    const ggml_tensor * conv      = cgraph->nodes[node_idx + 3];
+    const ggml_tensor * add       = cgraph->nodes[node_idx + (has_dyn ? 26 : 5)];
+    const ggml_tensor * scale     = cgraph->nodes[node_idx + (has_dyn ? 27 : 6)];
+
+    if (ggml_get_op_params_i32(concat, 0) != 0) {
+        return false;
+    }
+    const ggml_tensor * past      = concat->src[0];
+    const ggml_tensor * x_trans   = concat->src[1];
+    const ggml_tensor * view_cell = cpy->src[1];
+    const ggml_tensor * cur       = add->src[0];
+    const ggml_tensor * weight    = conv->src[1];
+
+    // verify concat->src[1] is transpose(reshape(cur)) for n_seq_tokens == 1, n_seqs == 1
+    if (!x_trans || x_trans->op != GGML_OP_TRANSPOSE || !x_trans->src[0] ||
+        x_trans->src[0]->op != GGML_OP_RESHAPE || x_trans->src[0]->src[0] != cur || !view_cell) {
+        return false;
+    }
+    const int64_t n_conv = weight->ne[0];
+    const int64_t C      = cur->ne[0];
+    if (n_conv < 2 || n_conv > 64 || cur->ne[1] != 1 || cur->ne[2] != 1 || cur->ne[3] != 1 ||
+        past->type != GGML_TYPE_F32 || past->nb[0] != sizeof(float) || past->ne[0] != n_conv - 1 || past->ne[1] != C || past->ne[2] != 1 || past->ne[3] != 1 ||
+        cur->type != GGML_TYPE_F32 || !ggml_is_contiguous(cur) ||
+        weight->type != GGML_TYPE_F32 || !ggml_is_contiguous(weight) || weight->ne[1] != C || weight->ne[2] != 1 || weight->ne[3] != 1 ||
+        view_last->view_offs != sizeof(float) || view_last->ne[0] != n_conv - 1 || view_last->ne[1] != C || view_last->ne[2] != 1 ||
+        view_cell->type != GGML_TYPE_F32 || !ggml_is_contiguous(view_cell) || view_cell->ne[0] != (n_conv - 1) * C || view_cell->ne[1] != 1 ||
+        cpy->type != GGML_TYPE_F32 ||
+        scale->type != GGML_TYPE_F32 || !ggml_is_contiguous(scale) || !ggml_are_same_shape(scale, cur) ||
+        ggml_get_op_params_f32(scale, 1) != 0.0f) {
+        return false;
+    }
+    if (has_dyn) {
+        if (n_conv != 4) {
+            return false;
+        }
+        const ggml_tensor * xt_rs  = cgraph->nodes[node_idx + 7];
+        const ggml_tensor * dyn_rs = cgraph->nodes[node_idx + 9];
+        const ggml_tensor * dyn    = dyn_rs->src[0];
+        const int64_t n_heads = dyn_rs->ne[1];
+        if (dyn->type != GGML_TYPE_F32 || !ggml_is_contiguous(dyn) ||
+            dyn_rs->ne[0] != 4 || n_heads < 1 || C % n_heads != 0 || dyn_rs->ne[2] != 1 ||
+            xt_rs->ne[0] != C / n_heads || xt_rs->ne[1] != n_heads || xt_rs->ne[2] != 4) {
+            return false;
+        }
+        const int win_idx[4] = { 8, 12, 16, 20 };
+        const int tap_idx[4] = { 10, 13, 17, 21 };
+        for (int lag = 0; lag < 4; ++lag) {
+            const ggml_tensor * wv = cgraph->nodes[node_idx + win_idx[lag]];
+            const ggml_tensor * tv = cgraph->nodes[node_idx + tap_idx[lag]];
+            if (wv->view_offs != (size_t)(3 - lag) * xt_rs->nb[2] ||
+                tv->view_offs != (size_t)lag * dyn_rs->nb[0]) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
