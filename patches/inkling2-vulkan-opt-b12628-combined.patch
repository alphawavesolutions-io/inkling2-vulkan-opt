+void ggml_vk_situ_dispatch_fused(ggml_backend_vk_context * ctx, vk_context& subctx, ggml_cgraph * cgraph, int node_idx) {
+    const ggml_tensor * scale0 = cgraph->nodes[node_idx + 0];
+    const ggml_tensor * scale1 = cgraph->nodes[node_idx + 4];
+    ggml_tensor *       scale2 = cgraph->nodes[node_idx + 7];
+
+    const ggml_tensor * gate = scale0->src[0];
+    const ggml_tensor * up   = scale1->src[0];
+
+    vk_pipeline pipeline = ctx->device->pipeline_situ_f32;
+    ggml_pipeline_request_descriptor_sets(ctx, pipeline, 1);
+
+    vk_subbuffer g_buf = ggml_vk_tensor_subbuffer(ctx, gate, true);
+    vk_subbuffer u_buf = ggml_vk_tensor_subbuffer(ctx, up,   true);
+    vk_subbuffer d_buf = ggml_vk_tensor_subbuffer(ctx, scale2, true);
+
+    const uint32_t ne0 = (uint32_t)gate->ne[0];
+    const uint32_t ne1 = (uint32_t)gate->ne[1];
+    const uint32_t ne2 = (uint32_t)gate->ne[2];
+    const uint32_t ne3 = (uint32_t)gate->ne[3];
+    vk_op_situ_push_constants pc {
+        ne0, ne1, ne2, ne3,
+        (uint32_t)(gate->nb[1] / sizeof(float)),
+        (uint32_t)(gate->nb[2] / sizeof(float)),
+        (uint32_t)(gate->nb[3] / sizeof(float)),
+        (uint32_t)(get_misalign_bytes(ctx, gate) / sizeof(float)),
+        (uint32_t)(up->nb[1] / sizeof(float)),
+        (uint32_t)(up->nb[2] / sizeof(float)),
+        (uint32_t)(up->nb[3] / sizeof(float)),
+        (uint32_t)(get_misalign_bytes(ctx, up) / sizeof(float)),
+        (uint32_t)(get_misalign_bytes(ctx, scale2) / sizeof(float)),
+        ggml_get_op_params_f32(scale0, 0),
+        ggml_get_op_params_f32(scale1, 0),
+        ggml_get_op_params_f32(scale2, 0),
+    };
+    const uint32_t total = ne0 * ne1 * ne2 * ne3;
+    ggml_vk_dispatch_pipeline(ctx, subctx, pipeline, { g_buf, u_buf, d_buf }, pc, { total, 1, 1 });
+}
