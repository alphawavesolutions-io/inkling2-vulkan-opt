+void ggml_vk_control_apply_dispatch_fused(ggml_backend_vk_context * ctx, vk_context& subctx, ggml_cgraph * cgraph, int node_idx) {
+    const ggml_tensor * tanh_f = cgraph->nodes[node_idx + 0];
+    const ggml_tensor * sub    = cgraph->nodes[node_idx + 2];
+    const ggml_tensor * tanh_g = cgraph->nodes[node_idx + 3];
+    const ggml_tensor * mul1   = cgraph->nodes[node_idx + 4];
+    ggml_tensor *       add    = cgraph->nodes[node_idx + 5];
+
+    const ggml_tensor * cur        = sub->src[0];
+    const ggml_tensor * msg        = mul1->src[1];
+    const ggml_tensor * gain_raw   = tanh_g->src[0];
+    const ggml_tensor * forget_raw = tanh_f->src[0];
+
+    vk_pipeline pipeline = ctx->device->pipeline_control_apply_f32;
+    ggml_pipeline_request_descriptor_sets(ctx, pipeline, 1);
+
+    vk_subbuffer cur_buf = ggml_vk_tensor_subbuffer(ctx, cur,        true);
+    vk_subbuffer msg_buf = ggml_vk_tensor_subbuffer(ctx, msg,        true);
+    vk_subbuffer g_buf   = ggml_vk_tensor_subbuffer(ctx, gain_raw,   true);
+    vk_subbuffer f_buf   = ggml_vk_tensor_subbuffer(ctx, forget_raw, true);
+    vk_subbuffer dst_buf = ggml_vk_tensor_subbuffer(ctx, add,        true);
+
+    const uint32_t n = (uint32_t)ggml_nelements(add);
+    vk_op_control_apply_push_constants pc {
+        n,
+        (uint32_t)(get_misalign_bytes(ctx, cur)        / sizeof(float)),
+        (uint32_t)(get_misalign_bytes(ctx, msg)        / sizeof(float)),
+        (uint32_t)(get_misalign_bytes(ctx, gain_raw)   / sizeof(float)),
+        (uint32_t)(get_misalign_bytes(ctx, forget_raw) / sizeof(float)),
+        (uint32_t)(get_misalign_bytes(ctx, add)        / sizeof(float)),
+    };
+    ggml_vk_dispatch_pipeline(ctx, subctx, pipeline, { cur_buf, msg_buf, g_buf, f_buf, dst_buf }, pc, { n, 1, 1 });
+}
