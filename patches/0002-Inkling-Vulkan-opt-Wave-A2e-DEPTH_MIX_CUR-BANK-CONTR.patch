diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/rel_bias_mask_direct.comp b/ggml/src/ggml-vulkan/vulkan-shaders/rel_bias_mask_direct.comp
new file mode 100644
index 0000000..3aa4913
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/rel_bias_mask_direct.comp
@@ -0,0 +1,73 @@
+#version 450
+
+#extension GL_EXT_control_flow_attributes : require
+#extension GL_EXT_shader_16bit_storage : require
+#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
+
+layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
+
+layout(binding = 0) readonly buffer Bias { float bias[]; };
+layout(binding = 1) readonly buffer Rcur { float rcur[]; };
+layout(binding = 2) readonly buffer Pos  { int rel_pos[]; };
+layout(binding = 3) readonly buffer Mask { float base_mask[]; };
+layout(binding = 4) writeonly buffer Dst { float16_t dst[]; };
+
+layout(push_constant) uniform PushConstants {
+    uint n_kv;
+    uint n_head;
+    uint n_rel;
+    uint n_extent;
+    uint off_bias;
+    uint off_r;
+    uint off_pos;
+    uint off_mask;
+    uint off_d;
+};
+
+shared float s_R[4 * 64];
+
+void main() {
+    const uint tid = gl_LocalInvocationID.x;
+    const uint h_base = gl_WorkGroupID.y * 4u;
+    const uint h_cnt = min(4u, n_head - h_base);
+
+    for (uint i = tid; i < h_cnt * n_rel; i += 64u) {
+        const uint lh = i / n_rel;
+        const uint r = i % n_rel;
+        s_R[lh * 64u + r] = rcur[off_r + (h_base + lh) * n_rel + r];
+    }
+    barrier();
+
+    const uint kv = gl_WorkGroupID.x * 64u + tid;
+    if (kv >= n_kv) {
+        return;
+    }
+
+    const float m = base_mask[off_mask + kv];
+    const uint pos = uint(rel_pos[off_pos + kv]);
+
+    if (pos < n_extent) {
+        float acc0 = 0.0;
+        float acc1 = 0.0;
+        float acc2 = 0.0;
+        float acc3 = 0.0;
+        const uint b_off = off_bias + pos * n_rel;
+        for (uint r = 0u; r < n_rel; ++r) {
+            const float bv = bias[b_off + r];
+            acc0 += bv * s_R[0u * 64u + r];
+            if (h_cnt > 1u) acc1 += bv * s_R[1u * 64u + r];
+            if (h_cnt > 2u) acc2 += bv * s_R[2u * 64u + r];
+            if (h_cnt > 3u) acc3 += bv * s_R[3u * 64u + r];
+        }
+        dst[off_d + (h_base + 0u) * n_kv + kv] = float16_t(m + acc0);
+        if (h_cnt > 1u) dst[off_d + (h_base + 1u) * n_kv + kv] = float16_t(m + acc1);
+        if (h_cnt > 2u) dst[off_d + (h_base + 2u) * n_kv + kv] = float16_t(m + acc2);
+        if (h_cnt > 3u) dst[off_d + (h_base + 3u) * n_kv + kv] = float16_t(m + acc3);
+    } else {
+        const float16_t mh = float16_t(m);
+        dst[off_d + (h_base + 0u) * n_kv + kv] = mh;
+        if (h_cnt > 1u) dst[off_d + (h_base + 1u) * n_kv + kv] = mh;
+        if (h_cnt > 2u) dst[off_d + (h_base + 2u) * n_kv + kv] = mh;
+        if (h_cnt > 3u) dst[off_d + (h_base + 3u) * n_kv + kv] = mh;
+    }
+}
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/ssm_conv_decode.comp b/ggml/src/ggml-vulkan/vulkan-shaders/ssm_conv_decode.comp
new file mode 100644
index 0000000..5b6c9c3
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/ssm_conv_decode.comp
@@ -0,0 +1,89 @@
+#version 450
+
+#extension GL_EXT_control_flow_attributes : require
+
+layout(constant_id = 0) const bool HAS_DYNAMIC = false;
+
+layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
+
+layout(binding = 0) readonly buffer Past     { float past[]; };
+layout(binding = 1) readonly buffer Cur      { float cur[]; };
+layout(binding = 2) readonly buffer Weight   { float weight[]; };
+layout(binding = 3) readonly buffer Dyn      { float dyn[]; };
+layout(binding = 4) writeonly buffer State   { float state_dst[]; };
+layout(binding = 5) writeonly buffer Dst     { float dst[]; };
+
+layout(push_constant) uniform PushConstants {
+    uint C;
+    uint n_conv;
+    uint head_dim;
+    uint past_nb1;
+    uint off_past;
+    uint off_cur;
+    uint off_w;
+    uint off_dyn;
+    uint off_state;
+    uint off_d;
+    float res_scale;
+};
+
+void main() {
+    const uint c = gl_GlobalInvocationID.x;
+    if (c >= C) {
+        return;
+    }
+
+    const uint n_past = n_conv - 1u;
+    const uint p_base = off_past + c * past_nb1;
+    const uint s_base = off_state + c * n_past;
+    const uint w_base = off_w + c * n_conv;
+    const float xc = cur[off_cur + c];
+
+    float sum = 0.0;
+    if (n_conv == 4u) {
+        float p0 = past[p_base + 0u];
+        float p1 = past[p_base + 1u];
+        float p2 = past[p_base + 2u];
+
+        state_dst[s_base + 0u] = p1;
+        state_dst[s_base + 1u] = p2;
+        state_dst[s_base + 2u] = xc;
+
+        sum = weight[w_base + 0u] * p0
+            + weight[w_base + 1u] * p1
+            + weight[w_base + 2u] * p2
+            + weight[w_base + 3u] * xc;
+
+        if (HAS_DYNAMIC) {
+            const uint d_base = off_dyn + (c / head_dim) * 4u;
+            sum += dyn[d_base + 0u] * xc
+                 + dyn[d_base + 1u] * p2
+                 + dyn[d_base + 2u] * p1
+                 + dyn[d_base + 3u] * p0;
+        }
+    } else {
+        float p_prev = past[p_base + 0u];
+        sum = weight[w_base + 0u] * p_prev;
+        if (HAS_DYNAMIC) {
+            const uint d_base = off_dyn + (c / head_dim) * n_conv;
+            sum += dyn[d_base + (n_conv - 1u)] * p_prev;
+        }
+        for (uint i = 1u; i < n_past; ++i) {
+            float pi = past[p_base + i];
+            state_dst[s_base + i - 1u] = pi;
+            sum += weight[w_base + i] * pi;
+            if (HAS_DYNAMIC) {
+                const uint d_base = off_dyn + (c / head_dim) * n_conv;
+                sum += dyn[d_base + (n_conv - 1u - i)] * pi;
+            }
+        }
+        state_dst[s_base + n_past - 1u] = xc;
+        sum += weight[w_base + n_past] * xc;
+        if (HAS_DYNAMIC) {
+            const uint d_base = off_dyn + (c / head_dim) * n_conv;
+            sum += dyn[d_base + 0u] * xc;
+        }
+    }
+
+    dst[off_d + c] = (xc + sum) * res_scale;
+}
