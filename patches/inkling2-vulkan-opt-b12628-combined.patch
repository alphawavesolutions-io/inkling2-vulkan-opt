+    const uint32_t n_kv         = (uint32_t)dst->ne[0];
+    const uint32_t n_per_stream = (uint32_t)dst->ne[1];
+    const uint32_t n_head       = (uint32_t)dst->ne[2];
+    const uint32_t n_stream     = (uint32_t)dst->ne[3];
+    const uint32_t n_buckets    = (uint32_t)table->ne[1];
+    vk_op_rel_bias_mask_push_constants pc {
+        n_kv, n_head, n_buckets, n_per_stream, n_stream,
