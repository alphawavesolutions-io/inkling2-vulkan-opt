+static bool ggml_vk_can_fuse_l2_clip(const ggml_backend_vk_context * ctx, const struct ggml_cgraph * cgraph, int node_idx, bool has_scale) {
+    const int off = has_scale ? 1 : 0;
+    const ggml_tensor * mul0  = has_scale ? cgraph->nodes[node_idx + 0] : nullptr;
+    const ggml_tensor * sqr   = cgraph->nodes[node_idx + off + 0];
+    const ggml_tensor * sb    = cgraph->nodes[node_idx + off + 3];
+    const ggml_tensor * dst   = cgraph->nodes[node_idx + off + 7];
+
+    const ggml_tensor * x = has_scale ? mul0->src[0] : sqr->src[0];
+    if (!has_scale && dst->src[0] != x) {
+        return false;
+    }
+    if (x->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous(x) || !ggml_is_contiguous(dst) ||
+        !ggml_are_same_shape(x, dst) ||
+        get_misalign_bytes(ctx, x) != 0 || get_misalign_bytes(ctx, dst) != 0) {
+        return false;
+    }
+    if (ggml_get_op_params_f32(sb, 0) != 1.0f) {
+        return false;
+    }
+    if (has_scale) {
+        const ggml_tensor * s = mul0->src[1];
+        if (s->type != GGML_TYPE_F32 || !ggml_is_contiguous(s) || get_misalign_bytes(ctx, s) != 0 ||
+            s->ne[0] != x->ne[0] || s->ne[1] != x->ne[1] || s->ne[2] != 1 || s->ne[3] != 1) {
+            return false;
+        }
+    }
+    if ((uint64_t)ggml_nrows(x) > ctx->device->properties.limits.maxComputeWorkGroupCount[0]) {
+        return false;
+    }
+    return true;
+}
+
+static bool ggml_vk_can_fuse_situ(const ggml_backend_vk_context * ctx, const struct ggml_cgraph * cgraph, int node_idx) {
+    GGML_UNUSED(ctx);
+    const ggml_tensor * scale0 = cgraph->nodes[node_idx + 0];
+    const ggml_tensor * tanh0  = cgraph->nodes[node_idx + 1];
+    const ggml_tensor * sig    = cgraph->nodes[node_idx + 2];
+    const ggml_tensor * scale1 = cgraph->nodes[node_idx + 4];
+    const ggml_tensor * tanh1  = cgraph->nodes[node_idx + 5];
+    const ggml_tensor * scale2 = cgraph->nodes[node_idx + 7];
+
+    if (ggml_get_unary_op(tanh0) != GGML_UNARY_OP_TANH ||
+        ggml_get_unary_op(sig)   != GGML_UNARY_OP_SIGMOID ||
+        ggml_get_unary_op(tanh1) != GGML_UNARY_OP_TANH) {
+        return false;
+    }
+    if (ggml_get_op_params_f32(scale0, 1) != 0.0f ||
+        ggml_get_op_params_f32(scale1, 1) != 0.0f ||
+        ggml_get_op_params_f32(scale2, 1) != 0.0f) {
+        return false;
+    }
+    const ggml_tensor * gate = scale0->src[0];
+    const ggml_tensor * up   = scale1->src[0];
+    if (sig->src[0] != gate) {
+        return false;
+    }
+    if (gate->type != GGML_TYPE_F32 || up->type != GGML_TYPE_F32 || scale2->type != GGML_TYPE_F32 ||
+        gate->nb[0] != sizeof(float) || up->nb[0] != sizeof(float) || !ggml_is_contiguous(scale2) ||
+        !ggml_are_same_shape(gate, up) || !ggml_are_same_shape(gate, scale2)) {
+        return false;
+    }
+    return true;
+}
+
+static bool ggml_vk_can_fuse_control_apply(const ggml_backend_vk_context * ctx, const struct ggml_cgraph * cgraph, int node_idx) {
+    GGML_UNUSED(ctx);
+    const ggml_tensor * tanh_f = cgraph->nodes[node_idx + 0];
+    const ggml_tensor * mul0   = cgraph->nodes[node_idx + 1];
+    const ggml_tensor * sub    = cgraph->nodes[node_idx + 2];
+    const ggml_tensor * tanh_g = cgraph->nodes[node_idx + 3];
+    const ggml_tensor * mul1   = cgraph->nodes[node_idx + 4];
+    const ggml_tensor * add    = cgraph->nodes[node_idx + 5];
+
+    if (ggml_get_unary_op(tanh_f) != GGML_UNARY_OP_TANH ||
+        ggml_get_unary_op(tanh_g) != GGML_UNARY_OP_TANH) {
+        return false;
+    }
+    const ggml_tensor * cur = sub->src[0];
+    if (mul0->src[1] != cur) {
+        return false;
+    }
+    const ggml_tensor * msg        = mul1->src[1];
+    const ggml_tensor * gain_raw   = tanh_g->src[0];
+    const ggml_tensor * forget_raw = tanh_f->src[0];
+    for (const ggml_tensor * t : { cur, msg, gain_raw, forget_raw, add }) {
+        if (t->type != GGML_TYPE_F32 || !ggml_is_contiguous(t) || !ggml_are_same_shape(t, add)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool ggml_vk_can_fuse_ssm_conv_res_scale(const ggml_backend_vk_context * ctx, const struct ggml_cgraph * cgraph, int node_idx) {
+    const ggml_tensor * conv    = cgraph->nodes[node_idx + 0];
+    const ggml_tensor * reshape = cgraph->nodes[node_idx + 1];
+    const ggml_tensor * add     = cgraph->nodes[node_idx + 2];
+    const ggml_tensor * scale   = cgraph->nodes[node_idx + 3];
+
+    if (add->src[0] != reshape && add->src[1] != reshape) {
+        return false;
+    }
+    const ggml_tensor * res = (add->src[0] == reshape) ? add->src[1] : add->src[0];
+    if (conv->type != GGML_TYPE_F32 || conv->src[0]->type != GGML_TYPE_F32 || conv->src[1]->type != GGML_TYPE_F32 ||
+        res->type != GGML_TYPE_F32 || scale->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous(reshape) || !ggml_is_contiguous(res) || !ggml_is_contiguous(scale) ||
+        !ggml_are_same_shape(res, add) || !ggml_are_same_shape(add, scale) ||
+        ggml_get_op_params_f32(scale, 1) != 0.0f ||
+        get_misalign_bytes(ctx, conv->src[0]) != 0 || get_misalign_bytes(ctx, conv->src[1]) != 0 ||
+        get_misalign_bytes(ctx, res) != 0 || get_misalign_bytes(ctx, scale) != 0) {
+        return false;
+    }
+    return true;
+}
+
+static bool ggml_vk_can_fuse_rel_bias_mask(const ggml_backend_vk_context * ctx, const struct ggml_cgraph * cgraph, int node_idx) {
+    if (!ctx->device->fp16 || !ctx->device->pipeline_rel_bias_mask_f32_f16) {
+        return false;
+    }
+    const ggml_tensor * get_rows = cgraph->nodes[node_idx + 0];
+    const ggml_tensor * reshape  = cgraph->nodes[node_idx + 1];
+    const ggml_tensor * perm     = cgraph->nodes[node_idx + 2];
+    const ggml_tensor * add      = cgraph->nodes[node_idx + 4];
+    const ggml_tensor * dst      = cgraph->nodes[node_idx + 5];
+
+    const ggml_tensor * table     = get_rows->src[0];
+    const ggml_tensor * rel_pos   = get_rows->src[1];
+    const ggml_tensor * base_mask = add->src[1];
+
+    if (table->type != GGML_TYPE_F32 || !ggml_is_contiguous(table) || table->ne[3] != 1 ||
+        rel_pos->type != GGML_TYPE_I32 || !ggml_is_contiguous(rel_pos) || rel_pos->ne[2] != 1 || rel_pos->ne[3] != 1 ||
+        base_mask->type != GGML_TYPE_F32 || base_mask->nb[0] != sizeof(float) || base_mask->ne[2] != 1 ||
+        dst->type != GGML_TYPE_F16 || !ggml_is_contiguous(dst) || dst->src[1] != dst) {
+        return false;
+    }
+    if (table->ne[2] != rel_pos->ne[1] ||
+        reshape->ne[0] != table->ne[0] || reshape->ne[1] != rel_pos->ne[0] ||
+        reshape->ne[2] * reshape->ne[3] != rel_pos->ne[1]) {
+        return false;
+    }
+    // verify exact permute(2, 0, 1, 3): [n_head, n_kv, n_per_stream, n_stream] -> [n_kv, n_per_stream, n_head, n_stream]
+    if (perm->ne[0] != reshape->ne[1] || perm->ne[1] != reshape->ne[2] ||
+        perm->ne[2] != reshape->ne[0] || perm->ne[3] != reshape->ne[3] ||
+        perm->nb[0] != reshape->nb[1] || perm->nb[1] != reshape->nb[2] ||
+        perm->nb[2] != reshape->nb[0] || perm->nb[3] != reshape->nb[3]) {
+        return false;
+    }
+    if (base_mask->ne[0] != dst->ne[0] || base_mask->ne[1] != dst->ne[1] || base_mask->ne[3] != dst->ne[3]) {
+        return false;
+    }
+    if ((uint64_t)rel_pos->ne[1] > ctx->device->properties.limits.maxComputeWorkGroupCount[2] ||
+        (uint64_t)table->ne[0] > ctx->device->properties.limits.maxComputeWorkGroupCount[1]) {
+        return false;
+    }
+    return true;
+}
