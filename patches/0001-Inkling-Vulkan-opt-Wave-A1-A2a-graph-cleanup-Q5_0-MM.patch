+    ggml_tensor *       dst    = cgraph->nodes[node_idx + off + 7];
+
+    vk_pipeline pipeline = ctx->device->pipeline_l2_clip_f32;
+    ggml_pipeline_request_descriptor_sets(ctx, pipeline, 1);
+
+    vk_subbuffer x_buf   = ggml_vk_tensor_subbuffer(ctx, x);
+    vk_subbuffer s_buf   = ggml_vk_tensor_subbuffer(ctx, scale);
+    vk_subbuffer dst_buf = ggml_vk_tensor_subbuffer(ctx, dst);
+
+    const uint32_t ne0   = (uint32_t)x->ne[0];
+    const uint32_t ne1   = (uint32_t)x->ne[1];
+    const uint32_t nrows = (uint32_t)ggml_nrows(x);
+    vk_op_l2_clip_push_constants pc {
+        ne0, ne1, nrows, has_scale ? 1u : 0u,
+        ggml_get_op_params_f32(sb, 1),
+        ggml_get_op_params_f32(fill, 0),
+        ggml_get_op_params_f32(clmp, 0),
+        ggml_get_op_params_f32(clmp, 1),
+    };
+    ggml_vk_dispatch_pipeline(ctx, subctx, pipeline, { x_buf, s_buf, dst_buf }, pc, { nrows, 1, 1 });
+}
+
+void ggml_vk_situ_dispatch_fused(ggml_backend_vk_context * ctx, vk_context& subctx, ggml_cgraph * cgraph, int node_idx) {
+    const ggml_tensor * scale0 = cgraph->nodes[node_idx + 0];
+    const ggml_tensor * scale1 = cgraph->nodes[node_idx + 4];
+    ggml_tensor *       scale2 = cgraph->nodes[node_idx + 7];
+
+    const ggml_tensor * gate = scale0->src[0];
+    const ggml_tensor * up   = scale1->src[0];
+
+    vk_pipeline pipeline = ctx->device->pipeline_situ_f32;
+    ggml_pipeline_request_descriptor_sets(ctx, pipeline, 1);
+
+    vk_subbuffer g_buf = ggml_vk_tensor_subbuffer(ctx, gate, true);
+    vk_subbuffer u_buf = ggml_vk_tensor_subbuffer(ctx, up,   true);
+    vk_subbuffer d_buf = ggml_vk_tensor_subbuffer(ctx, scale2, true);
+
+    const uint32_t ne0 = (uint32_t)gate->ne[0];
+    const uint32_t ne1 = (uint32_t)gate->ne[1];
+    const uint32_t ne2 = (uint32_t)gate->ne[2];
+    const uint32_t ne3 = (uint32_t)gate->ne[3];
+    vk_op_situ_push_constants pc {
+        ne0, ne1, ne2, ne3,
+        (uint32_t)(gate->nb[1] / sizeof(float)),
+        (uint32_t)(gate->nb[2] / sizeof(float)),
+        (uint32_t)(gate->nb[3] / sizeof(float)),
+        (uint32_t)(get_misalign_bytes(ctx, gate) / sizeof(float)),
+        (uint32_t)(up->nb[1] / sizeof(float)),
+        (uint32_t)(up->nb[2] / sizeof(float)),
+        (uint32_t)(up->nb[3] / sizeof(float)),
+        (uint32_t)(get_misalign_bytes(ctx, up) / sizeof(float)),
+        (uint32_t)(get_misalign_bytes(ctx, scale2) / sizeof(float)),
+        ggml_get_op_params_f32(scale0, 0),
+        ggml_get_op_params_f32(scale1, 0),
+        ggml_get_op_params_f32(scale2, 0),
+    };
+    const uint32_t total = ne0 * ne1 * ne2 * ne3;
+    ggml_vk_dispatch_pipeline(ctx, subctx, pipeline, { g_buf, u_buf, d_buf }, pc, { total, 1, 1 });
+}
+
+void ggml_vk_control_apply_dispatch_fused(ggml_backend_vk_context * ctx, vk_context& subctx, ggml_cgraph * cgraph, int node_idx) {
+    const ggml_tensor * tanh_f = cgraph->nodes[node_idx + 0];
+    const ggml_tensor * sub    = cgraph->nodes[node_idx + 2];
+    const ggml_tensor * tanh_g = cgraph->nodes[node_idx + 3];
+    const ggml_tensor * mul1   = cgraph->nodes[node_idx + 4];
+    ggml_tensor *       add    = cgraph->nodes[node_idx + 5];
+
+    const ggml_tensor * cur        = sub->src[0];
+    const ggml_tensor * msg        = mul1->src[1];
+    const ggml_tensor * gain_raw   = tanh_g->src[0];
+    const ggml_tensor * forget_raw = tanh_f->src[0];
+
+    vk_pipeline pipeline = ctx->device->pipeline_control_apply_f32;
+    ggml_pipeline_request_descriptor_sets(ctx, pipeline, 1);
+
+    vk_subbuffer cur_buf = ggml_vk_tensor_subbuffer(ctx, cur,        true);
+    vk_subbuffer msg_buf = ggml_vk_tensor_subbuffer(ctx, msg,        true);
+    vk_subbuffer g_buf   = ggml_vk_tensor_subbuffer(ctx, gain_raw,   true);
+    vk_subbuffer f_buf   = ggml_vk_tensor_subbuffer(ctx, forget_raw, true);
+    vk_subbuffer dst_buf = ggml_vk_tensor_subbuffer(ctx, add,        true);
+
+    const uint32_t n = (uint32_t)ggml_nelements(add);
+    vk_op_control_apply_push_constants pc {
+        n,
+        (uint32_t)(get_misalign_bytes(ctx, cur)        / sizeof(float)),
+        (uint32_t)(get_misalign_bytes(ctx, msg)        / sizeof(float)),
+        (uint32_t)(get_misalign_bytes(ctx, gain_raw)   / sizeof(float)),
+        (uint32_t)(get_misalign_bytes(ctx, forget_raw) / sizeof(float)),
+        (uint32_t)(get_misalign_bytes(ctx, add)        / sizeof(float)),
+    };
+    ggml_vk_dispatch_pipeline(ctx, subctx, pipeline, { cur_buf, msg_buf, g_buf, f_buf, dst_buf }, pc, { n, 1, 1 });
+}
+
+void ggml_vk_rel_bias_mask_dispatch_fused(ggml_backend_vk_context * ctx, vk_context& subctx, ggml_cgraph * cgraph, int node_idx) {
+    const ggml_tensor * get_rows = cgraph->nodes[node_idx + 0];
+    const ggml_tensor * add      = cgraph->nodes[node_idx + 4];
+    ggml_tensor *       dst      = cgraph->nodes[node_idx + 5];
+
+    const ggml_tensor * table     = get_rows->src[0];
+    const ggml_tensor * rel_pos   = get_rows->src[1];
+    const ggml_tensor * base_mask = add->src[1];
+
+    vk_pipeline pipeline = ctx->device->pipeline_rel_bias_mask_f32_f16;
+    ggml_pipeline_request_descriptor_sets(ctx, pipeline, 1);
+
+    vk_subbuffer t_buf = ggml_vk_tensor_subbuffer(ctx, table,     true);
+    vk_subbuffer p_buf = ggml_vk_tensor_subbuffer(ctx, rel_pos,   true);
+    vk_subbuffer m_buf = ggml_vk_tensor_subbuffer(ctx, base_mask, true);
+    vk_subbuffer d_buf = ggml_vk_tensor_subbuffer(ctx, dst,       true);
+
+    const uint32_t n_kv         = (uint32_t)dst->ne[0];
+    const uint32_t n_per_stream = (uint32_t)dst->ne[1];
+    const uint32_t n_head       = (uint32_t)dst->ne[2];
+    const uint32_t n_stream     = (uint32_t)dst->ne[3];
+    const uint32_t n_buckets    = (uint32_t)table->ne[1];
+    vk_op_rel_bias_mask_push_constants pc {
+        n_kv, n_head, n_buckets, n_per_stream, n_stream,
+        (uint32_t)(base_mask->nb[1] / sizeof(float)),
+        (uint32_t)(base_mask->nb[3] / sizeof(float)),
+        (uint32_t)(get_misalign_bytes(ctx, table)     / sizeof(float)),
+        (uint32_t)(get_misalign_bytes(ctx, rel_pos)   / sizeof(int32_t)),
+        (uint32_t)(get_misalign_bytes(ctx, base_mask) / sizeof(float)),
+        (uint32_t)(get_misalign_bytes(ctx, dst)       / sizeof(ggml_fp16_t)),
+    };
+    ggml_vk_dispatch_pipeline(ctx, subctx, pipeline, { t_buf, p_buf, m_buf, d_buf }, pc, { n_kv, n_head, n_per_stream * n_stream });
+}
