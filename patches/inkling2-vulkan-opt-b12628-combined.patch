+static bool ggml_vk_can_fuse_rel_bias_mask(const ggml_backend_vk_context * ctx, const struct ggml_cgraph * cgraph, int node_idx) {
+    if (!ctx->device->fp16 || !ctx->device->pipeline_rel_bias_mask_f32_f16) {
+        return false;
+    }
+    const ggml_tensor * get_rows = cgraph->nodes[node_idx + 0];
+    const ggml_tensor * reshape  = cgraph->nodes[node_idx + 1];
+    const ggml_tensor * perm     = cgraph->nodes[node_idx + 2];
+    const ggml_tensor * add      = cgraph->nodes[node_idx + 4];
+    const ggml_tensor * dst      = cgraph->nodes[node_idx + 5];
+
+    const ggml_tensor * table     = get_rows->src[0];
+    const ggml_tensor * rel_pos   = get_rows->src[1];
+    const ggml_tensor * base_mask = add->src[1];
+
+    if (table->type != GGML_TYPE_F32 || !ggml_is_contiguous(table) || table->ne[3] != 1 ||
+        rel_pos->type != GGML_TYPE_I32 || !ggml_is_contiguous(rel_pos) || rel_pos->ne[2] != 1 || rel_pos->ne[3] != 1 ||
+        base_mask->type != GGML_TYPE_F32 || base_mask->nb[0] != sizeof(float) || base_mask->ne[2] != 1 ||
+        dst->type != GGML_TYPE_F16 || !ggml_is_contiguous(dst) || dst->src[1] != dst) {
+        return false;
+    }
+    if (table->ne[2] != rel_pos->ne[1] ||
+        reshape->ne[0] != table->ne[0] || reshape->ne[1] != rel_pos->ne[0] ||
+        reshape->ne[2] * reshape->ne[3] != rel_pos->ne[1]) {
+        return false;
+    }
+    // verify exact permute(2, 0, 1, 3): [n_head, n_kv, n_per_stream, n_stream] -> [n_kv, n_per_stream, n_head, n_stream]
+    if (perm->ne[0] != reshape->ne[1] || perm->ne[1] != reshape->ne[2] ||
+        perm->ne[2] != reshape->ne[0] || perm->ne[3] != reshape->ne[3] ||
+        perm->nb[0] != reshape->nb[1] || perm->nb[1] != reshape->nb[2] ||
+        perm->nb[2] != reshape->nb[0] || perm->nb[3] != reshape->nb[3]) {
+        return false;
+    }
+    if (base_mask->ne[0] != dst->ne[0] || base_mask->ne[1] != dst->ne[1] || base_mask->ne[3] != dst->ne[3]) {
+        return false;
+    }
+    if ((uint64_t)rel_pos->ne[1] > ctx->device->properties.limits.maxComputeWorkGroupCount[2] ||
+        (uint64_t)table->ne[0] > ctx->device->properties.limits.maxComputeWorkGroupCount[1]) {
+        return false;
+    }
+    return true;
+}
+
+static bool ggml_vk_can_fuse_rel_bias_mask_direct(const ggml_backend_vk_context * ctx, const struct ggml_cgraph * cgraph, int node_idx) {
+    if (!ctx->device->fp16 || !ctx->device->pipeline_rel_bias_mask_direct_f32_f16) {
+        return false;
+    }
+    const ggml_tensor * pad      = cgraph->nodes[node_idx + 0];
+    const ggml_tensor * mm       = cgraph->nodes[node_idx + 1];
+    const ggml_tensor * perm0    = cgraph->nodes[node_idx + 2];
+    const ggml_tensor * table    = cgraph->nodes[node_idx + 3];
+    const ggml_tensor * get_rows = cgraph->nodes[node_idx + 4];
+    const ggml_tensor * reshape  = cgraph->nodes[node_idx + 5];
+    const ggml_tensor * perm1    = cgraph->nodes[node_idx + 6];
+    const ggml_tensor * add      = cgraph->nodes[node_idx + 8];
+    const ggml_tensor * dst      = cgraph->nodes[node_idx + 9];
+
+    // verify pad is strictly (0, 0, 0, 1, 0, 0, 0, 0) i.e. ggml_pad(bias, 0, 1, 0, 0)
+    if (ggml_get_op_params_i32(pad, 0) != 0 || ggml_get_op_params_i32(pad, 1) != 0 ||
+        ggml_get_op_params_i32(pad, 2) != 0 || ggml_get_op_params_i32(pad, 3) != 1 ||
+        ggml_get_op_params_i32(pad, 4) != 0 || ggml_get_op_params_i32(pad, 5) != 0 ||
+        ggml_get_op_params_i32(pad, 6) != 0 || ggml_get_op_params_i32(pad, 7) != 0) {
+        return false;
+    }
+
+    const ggml_tensor * bias      = pad->src[0];
+    const ggml_tensor * rcur      = mm->src[1];
+    const ggml_tensor * rel_pos   = get_rows->src[1];
+    const ggml_tensor * base_mask = add->src[1];
+
+    if (bias->type != GGML_TYPE_F32 || !ggml_is_contiguous(bias) || bias->ne[2] != 1 || bias->ne[3] != 1 ||
+        bias->ne[0] > 64 ||
+        rcur->type != GGML_TYPE_F32 || !ggml_is_contiguous(rcur) || rcur->ne[0] != bias->ne[0] || rcur->ne[2] != 1 || rcur->ne[3] != 1 ||
+        rel_pos->type != GGML_TYPE_I32 || !ggml_is_contiguous(rel_pos) || rel_pos->ne[1] != 1 || rel_pos->ne[2] != 1 || rel_pos->ne[3] != 1 ||
+        base_mask->type != GGML_TYPE_F32 || base_mask->nb[0] != sizeof(float) || base_mask->ne[1] != 1 || base_mask->ne[2] != 1 || base_mask->ne[3] != 1 ||
+        dst->type != GGML_TYPE_F16 || !ggml_is_contiguous(dst) || dst->src[1] != dst) {
+        return false;
+    }
+    // verify perm0 = permute(1, 0, 2, 3) on [n_extent+1, n_head, 1, 1] -> [n_head, n_extent+1, 1, 1]
+    if (perm0->ne[0] != rcur->ne[1] || perm0->ne[1] != bias->ne[1] + 1 ||
+        perm0->nb[0] != mm->nb[1] || perm0->nb[1] != mm->nb[0] ||
+        table->ne[0] != rcur->ne[1] || table->ne[1] != bias->ne[1] + 1 || table->ne[2] != 1) {
+        return false;
+    }
+    // verify reshape [n_head, n_kv, 1, 1] and perm1 = permute(2, 0, 1, 3) -> [n_kv, 1, n_head, 1]
+    if (reshape->ne[0] != rcur->ne[1] || reshape->ne[1] != rel_pos->ne[0] || reshape->ne[2] != 1 || reshape->ne[3] != 1 ||
+        perm1->ne[0] != rel_pos->ne[0] || perm1->ne[1] != 1 || perm1->ne[2] != rcur->ne[1] || perm1->ne[3] != 1 ||
+        perm1->nb[0] != reshape->nb[1] || perm1->nb[2] != reshape->nb[0] ||
+        base_mask->ne[0] != dst->ne[0] || dst->ne[1] != 1 || dst->ne[2] != rcur->ne[1] || dst->ne[3] != 1) {
+        return false;
+    }
+    return true;
+}
+
+static bool ggml_vk_can_fuse_depth_mix(const ggml_backend_vk_context * ctx, const struct ggml_cgraph * cgraph, int node_idx, bool has_cur) {
+    if (!ctx->device->subgroup_arithmetic || ctx->device->subgroup_size < 16) {
+        return false;
+    }
+    vk_pipeline pipe = has_cur ? ctx->device->pipeline_depth_mix_cur_f32 : ctx->device->pipeline_depth_mix_bank_f32;
+    if (!pipe) {
+        return false;
+    }
+    const ggml_tensor * states = nullptr;
+    const ggml_tensor * cur    = nullptr;
+    const ggml_tensor * query  = nullptr;
+    const ggml_tensor * sm     = nullptr;
+    const ggml_tensor * dst    = nullptr;
+
+    if (has_cur) {
+        const ggml_tensor * rms    = cgraph->nodes[node_idx + 0];
+        const ggml_tensor * concat = cgraph->nodes[node_idx + 2];
+        const ggml_tensor * q_op   = cgraph->nodes[node_idx + 5];
+        sm  = cgraph->nodes[node_idx + 7];
+        dst = cgraph->nodes[node_idx + 8];
+        if (ggml_get_op_params_i32(concat, 0) != 1) {
+            return false;
+        }
+        states = concat->src[0];
+        cur    = rms->src[0];
+        query  = q_op->src[0];
+        if (cur->type != GGML_TYPE_F32 || !ggml_is_contiguous(cur) || cur->ne[0] != states->ne[0] ||
+            cur->ne[1] != states->ne[2] || cur->ne[2] != 1 || cur->ne[3] != 1) {
+            return false;
+        }
+    } else {
+        const bool has_rep = cgraph->nodes[node_idx + 0]->op == GGML_OP_REPEAT;
+        const int off = has_rep ? 1 : 0;
+        const ggml_tensor * mm0 = cgraph->nodes[node_idx + off + 0];
+        sm  = cgraph->nodes[node_idx + off + 1];
+        dst = cgraph->nodes[node_idx + off + 2];
+        states = mm0->src[0];
+        query  = has_rep ? cgraph->nodes[node_idx + 0]->src[0] : mm0->src[1];
+        // verify dst->src[0] (bank_states_t) is indeed CONT(TRANSPOSE(states))
+        const ggml_tensor * st_t = dst->src[0];
+        if (!st_t || st_t->op != GGML_OP_CONT || !st_t->src[0] || st_t->src[0]->op != GGML_OP_TRANSPOSE ||
+            st_t->src[0]->src[0] != states) {
+            return false;
+        }
+    }
+
+    // no attention mask or alibi on depth-mix softmax
+    if (sm->src[1] != nullptr || ggml_get_op_params_f32(sm, 1) != 0.0f) {
+        return false;
+    }
+    if (states->type != GGML_TYPE_F32 || !ggml_is_contiguous(states) || states->ne[3] != 1 ||
+        query->type != GGML_TYPE_F32  || !ggml_is_contiguous(query)  || query->ne[2] != 1 || query->ne[3] != 1 ||
+        dst->type != GGML_TYPE_F32    || !ggml_is_contiguous(dst)    || dst->ne[3] != 1) {
+        return false;
+    }
+    const int64_t K_tot = states->ne[1] + (has_cur ? 1 : 0);
+    const int64_t Q     = dst->ne[1];
+    if (states->ne[0] != query->ne[0] || dst->ne[0] != states->ne[0] || dst->ne[2] != states->ne[2] ||
+        (states->ne[0] % 4) != 0 ||
+        (get_misalign_bytes(ctx, states) % 16) != 0 ||
+        (has_cur && (get_misalign_bytes(ctx, cur) % 16) != 0) ||
+        (get_misalign_bytes(ctx, query) % 16) != 0 ||
+        (get_misalign_bytes(ctx, dst) % 16) != 0 ||
+        query->ne[1] != Q || states->ne[1] > 7 || K_tot < 1 || K_tot > 8 || Q < 1 || Q > 8) {
+        return false;
+    }
+    if ((uint64_t)dst->ne[2] > ctx->device->properties.limits.maxComputeWorkGroupCount[0]) {
+        return false;
+    }
+    return true;
+}
+
+static bool ggml_vk_can_fuse_ssm_conv_decode(const ggml_backend_vk_context * ctx, const struct ggml_cgraph * cgraph, int node_idx, bool has_dyn) {
+    vk_pipeline pipe = has_dyn ? ctx->device->pipeline_ssm_conv_decode_dyn_f32 : ctx->device->pipeline_ssm_conv_decode_f32;
+    if (!pipe) {
+        return false;
+    }
+    const ggml_tensor * concat    = cgraph->nodes[node_idx + 0];
+    const ggml_tensor * view_last = cgraph->nodes[node_idx + 1];
+    const ggml_tensor * cpy       = cgraph->nodes[node_idx + 2];
+    const ggml_tensor * conv      = cgraph->nodes[node_idx + 3];
+    const ggml_tensor * add       = cgraph->nodes[node_idx + (has_dyn ? 21 : 5)];
+    const ggml_tensor * scale     = cgraph->nodes[node_idx + (has_dyn ? 22 : 6)];
+
+    if (ggml_get_op_params_i32(concat, 0) != 0) {
+        return false;
+    }
+    const ggml_tensor * past      = concat->src[0];
+    const ggml_tensor * x_trans   = concat->src[1];
+    const ggml_tensor * view_cell = cpy->src[1];
+    const ggml_tensor * cur       = add->src[0];
+    const ggml_tensor * weight    = conv->src[1];
+
+    // verify concat->src[1] is transpose(reshape(cur)) for n_seq_tokens == 1, n_seqs == 1
+    if (!x_trans || x_trans->op != GGML_OP_TRANSPOSE || !x_trans->src[0] ||
+        x_trans->src[0]->op != GGML_OP_RESHAPE || x_trans->src[0]->src[0] != cur || !view_cell) {
+        return false;
+    }
+    const int64_t n_conv = weight->ne[0];
+    const int64_t C      = cur->ne[0];
+    if (n_conv < 2 || n_conv > 64 || cur->ne[1] != 1 || cur->ne[2] != 1 || cur->ne[3] != 1 ||
+        past->type != GGML_TYPE_F32 || past->nb[0] != sizeof(float) || past->ne[0] != n_conv - 1 || past->ne[1] != C || past->ne[2] != 1 || past->ne[3] != 1 ||
+        cur->type != GGML_TYPE_F32 || !ggml_is_contiguous(cur) ||
+        weight->type != GGML_TYPE_F32 || !ggml_is_contiguous(weight) || weight->ne[1] != C || weight->ne[2] != 1 || weight->ne[3] != 1 ||
+        view_last->view_offs != sizeof(float) || view_last->ne[0] != n_conv - 1 || view_last->ne[1] != C || view_last->ne[2] != 1 ||
+        view_cell->type != GGML_TYPE_F32 || !ggml_is_contiguous(view_cell) || view_cell->ne[0] != (n_conv - 1) * C || view_cell->ne[1] != 1 ||
+        cpy->type != GGML_TYPE_F32 ||
+        scale->type != GGML_TYPE_F32 || !ggml_is_contiguous(scale) || !ggml_are_same_shape(scale, cur) ||
+        ggml_get_op_params_f32(scale, 1) != 0.0f) {
+        return false;
+    }
+    if (has_dyn) {
+        if (n_conv != 4) {
+            return false;
+        }
+        const ggml_tensor * xt_rs = cgraph->nodes[node_idx + 7];
+        const int win_idx[4] = { 8, 10, 13, 16 };
+        const int mul_idx[4] = { 9, 11, 14, 17 };
+        const ggml_tensor * tap0 = cgraph->nodes[node_idx + mul_idx[0]]->src[1];
+        if (!tap0 || tap0->op != GGML_OP_VIEW || !tap0->src[0] || tap0->src[0]->op != GGML_OP_RESHAPE || !tap0->src[0]->src[0]) {
+            return false;
+        }
+        const ggml_tensor * dyn_rs = tap0->src[0];
+        const ggml_tensor * dyn    = dyn_rs->src[0];
+        const int64_t n_heads = dyn_rs->ne[1];
+        if (dyn->type != GGML_TYPE_F32 || !ggml_is_contiguous(dyn) ||
+            dyn_rs->ne[0] != 4 || n_heads < 1 || C % n_heads != 0 || dyn_rs->ne[2] != 1 ||
+            xt_rs->ne[0] != C / n_heads || xt_rs->ne[1] != n_heads || xt_rs->ne[2] != 4) {
+            return false;
+        }
+        for (int lag = 0; lag < 4; ++lag) {
+            const ggml_tensor * wv = cgraph->nodes[node_idx + win_idx[lag]];
+            const ggml_tensor * tv = cgraph->nodes[node_idx + mul_idx[lag]]->src[1];
+            if (!tv || tv->op != GGML_OP_VIEW || tv->src[0] != dyn_rs ||
+                wv->view_offs != (size_t)(3 - lag) * xt_rs->nb[2] ||
+                tv->view_offs != (size_t)lag * dyn_rs->nb[0]) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+static bool ggml_vk_can_fuse_control_down_q8_0(const ggml_backend_vk_context * ctx, const struct ggml_cgraph * cgraph, int node_idx) {
+    if (!ctx->device->fp16 || !ctx->device->subgroup_arithmetic || ctx->device->subgroup_size < 16 ||
+        !ctx->device->pipeline_control_down_q8_0_f32) {
+        return false;
+    }
+    const ggml_tensor * rms0   = cgraph->nodes[node_idx + 0];
+    const ggml_tensor * rms1   = cgraph->nodes[node_idx + 1];
+    const ggml_tensor * concat = cgraph->nodes[node_idx + 2];
+    const ggml_tensor * mm     = cgraph->nodes[node_idx + 3];
+
+    if (ggml_get_op_params_i32(concat, 0) != 0) {
+        return false;
+    }
+    if (ggml_get_op_params_f32(rms0, 0) != ggml_get_op_params_f32(rms1, 0)) {
+        return false;
+    }
+    const ggml_tensor * cur = rms0->src[0];
+    const ggml_tensor * msg = rms1->src[0];
+    const ggml_tensor * w   = mm->src[0];
+
+    if (cur->type != GGML_TYPE_F32 || !ggml_is_contiguous(cur) || cur->ne[1] != 1 || cur->ne[2] != 1 || cur->ne[3] != 1 ||
+        msg->type != GGML_TYPE_F32 || !ggml_is_contiguous(msg) || !ggml_are_same_shape(cur, msg) ||
+        cur->ne[0] % 32 != 0 ||
+        (get_misalign_bytes(ctx, cur) % 16) != 0 || (get_misalign_bytes(ctx, msg) % 16) != 0 ||
+        w->type != GGML_TYPE_Q8_0 || !ggml_is_contiguous(w) || w->ne[0] != 2 * cur->ne[0] || w->ne[2] != 1 || w->ne[3] != 1 ||
+        get_misalign_bytes(ctx, w) != 0 ||
+        mm->type != GGML_TYPE_F32 || !ggml_is_contiguous(mm) || mm->ne[1] != 1 || mm->ne[2] != 1 || mm->ne[3] != 1) {
+        return false;
+    }
+    return true;
+}
