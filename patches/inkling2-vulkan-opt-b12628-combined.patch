diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/control_apply.comp b/ggml/src/ggml-vulkan/vulkan-shaders/control_apply.comp
new file mode 100644
index 0000000..93a8d48
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/control_apply.comp
@@ -0,0 +1,32 @@
+#version 450
+
+// Fused Inkling loop controller tail:
+//   dst = (cur - tanh(forget_raw) * cur) + tanh(gain_raw) * message
+layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+layout(binding = 0) readonly  buffer Cur    { float data_cur[]; };
+layout(binding = 1) readonly  buffer Msg    { float data_msg[]; };
+layout(binding = 2) readonly  buffer Gain   { float data_gain[]; };
+layout(binding = 3) readonly  buffer Forget { float data_forget[]; };
+layout(binding = 4) writeonly buffer Dst    { float data_d[]; };
+
+layout(push_constant) uniform parameter {
+    uint n;
+    uint off_cur;
+    uint off_msg;
+    uint off_gain;
+    uint off_forget;
+    uint off_d;
+} p;
+
+void main() {
+    const uint i = gl_GlobalInvocationID.x;
+    if (i >= p.n) {
+        return;
+    }
+    const float c = data_cur[p.off_cur + i];
+    const float m = data_msg[p.off_msg + i];
+    const float f = tanh(data_forget[p.off_forget + i]);
+    const float g = tanh(data_gain[p.off_gain + i]);
+    data_d[p.off_d + i] = (c - f * c) + g * m;
+}
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/control_down_q8_0.comp b/ggml/src/ggml-vulkan/vulkan-shaders/control_down_q8_0.comp
new file mode 100644
index 0000000..98bd47c
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/control_down_q8_0.comp
@@ -0,0 +1,110 @@
+#version 450
+
+#extension GL_EXT_control_flow_attributes : require
+#extension GL_EXT_shader_16bit_storage : require
+#extension GL_EXT_shader_8bit_storage : require
+#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
+#extension GL_KHR_shader_subgroup_basic : require
+#extension GL_KHR_shader_subgroup_arithmetic : require
+
+#include "types.glsl"
+
+layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+layout(binding = 0) readonly buffer W   { block_q8_0_packed16 data_w[]; };
+layout(binding = 1) readonly buffer Cur { vec4 cur[]; };
+layout(binding = 2) readonly buffer Msg { vec4 msg[]; };
+layout(binding = 3) writeonly buffer Dst { float dst[]; };
+
+layout(push_constant) uniform PushConstants {
+    uint D;
+    uint M;
+    uint off_cur4;
+    uint off_msg4;
+    uint off_d;
+    float eps;
+};
+
+shared float s_red[3][16];
+
+void main() {
+    const uint row = gl_WorkGroupID.x;
+    if (row >= M) {
+        return;
+    }
+
+    const uint tid  = gl_LocalInvocationID.x;
+    const uint sg   = gl_SubgroupID;
+    const uint n_sg = gl_NumSubgroups;
+    const uint D4   = D >> 2;
+
+    float sq0 = 0.0;
+    float sq1 = 0.0;
+    for (uint d = tid; d < D4; d += 256u) {
+        vec4 v0 = cur[off_cur4 + d];
+        vec4 v1 = msg[off_msg4 + d];
+        sq0 += dot(v0, v0);
+        sq1 += dot(v1, v1);
+    }
+
+    sq0 = subgroupAdd(sq0);
+    sq1 = subgroupAdd(sq1);
+    if (n_sg > 1u) {
+        if (subgroupElect()) {
+            s_red[0][sg] = sq0;
+            s_red[1][sg] = sq1;
+        }
+        barrier();
+        sq0 = 0.0;
+        sq1 = 0.0;
+        for (uint s = 0u; s < n_sg; ++s) {
+            sq0 += s_red[0][s];
+            sq1 += s_red[1][s];
+        }
+    }
+
+    const float inv0 = inversesqrt(sq0 / float(D) + eps);
+    const float inv1 = inversesqrt(sq1 / float(D) + eps);
+
+    const uint half_blocks  = D >> 5;
+    const uint total_blocks = half_blocks * 2u;
+    const uint total_v4     = D4 * 2u;
+    const uint row_base     = row * total_blocks;
+
+    float acc0 = 0.0;
+    float acc1 = 0.0;
+    for (uint idx = tid; idx < total_v4; idx += 256u) {
+        const uint b = idx >> 3;
+        const uint j = idx & 7u;
+        const float d_w = float(data_w[row_base + b].d);
+        const int q01 = int(data_w[row_base + b].qs[2u * j]);
+        const int q23 = int(data_w[row_base + b].qs[2u * j + 1u]);
+        const vec4 qv = vec4(
+            float(bitfieldExtract(q01, 0, 8)),
+            float(bitfieldExtract(q01, 8, 8)),
+            float(bitfieldExtract(q23, 0, 8)),
+            float(bitfieldExtract(q23, 8, 8)));
+        if (idx < D4) {
+            acc0 += d_w * dot(qv, cur[off_cur4 + idx]);
+        } else {
+            acc1 += d_w * dot(qv, msg[off_msg4 + idx - D4]);
+        }
+    }
+
+    float tot = subgroupAdd(acc0 * inv0 + acc1 * inv1);
+    if (n_sg > 1u) {
+        if (subgroupElect()) {
+            s_red[2][sg] = tot;
+        }
+        barrier();
+        if (tid == 0u) {
+            float sum = 0.0;
+            for (uint s = 0u; s < n_sg; ++s) {
+                sum += s_red[2][s];
+            }
+            dst[off_d + row] = sum;
+        }
+    } else if (tid == 0u) {
+        dst[off_d + row] = tot;
+    }
+}
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/control_up_apply_q8_0.comp b/ggml/src/ggml-vulkan/vulkan-shaders/control_up_apply_q8_0.comp
new file mode 100644
index 0000000..088456b
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/control_up_apply_q8_0.comp
@@ -0,0 +1,85 @@
+#version 450
+
+#extension GL_EXT_control_flow_attributes : require
+#extension GL_EXT_shader_16bit_storage : require
+#extension GL_EXT_shader_8bit_storage : require
+#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
+#extension GL_KHR_shader_subgroup_basic : require
+#extension GL_KHR_shader_subgroup_shuffle : require
+
+#include "types.glsl"
+
+layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
+
+layout(binding = 0) readonly buffer WGain   { block_q8_0_packed16 w_gain[]; };
+layout(binding = 1) readonly buffer WForget { block_q8_0_packed16 w_forget[]; };
+layout(binding = 2) readonly buffer Gate    { float gate[]; };
+layout(binding = 3) readonly buffer Cur     { float cur[]; };
+layout(binding = 4) readonly buffer Msg     { float msg[]; };
+layout(binding = 5) writeonly buffer Dst    { float dst[]; };
+
+layout(push_constant) uniform PushConstants {
+    uint D;
+    uint K;
+    uint off_gate;
+    uint off_cur;
+    uint off_msg;
+    uint off_d;
+};
+
+shared float s_gate[256];
+
+void main() {
+    const uint tid = gl_LocalInvocationID.x;
+    for (uint i = tid; i < K; i += 64u) {
+        s_gate[i] = gate[off_gate + i];
+    }
+    barrier();
+
+    const uint lane4 = tid & 3u;
+    const uint r = gl_WorkGroupID.x * 16u + (tid >> 2);
+    const uint num_blocks = K >> 5;
+
+    float g_acc = 0.0;
+    float f_acc = 0.0;
+
+    if (r < D) {
+        const uint row_base = r * num_blocks;
+        for (uint bh = lane4; bh < num_blocks * 2u; bh += 4u) {
+            const uint b = bh >> 1;
+            const uint hi = bh & 1u;
+            const uint q_off = hi * 8u;
+            const uint x_base = b * 32u + hi * 16u;
+
+            const float dg = float(w_gain[row_base + b].d);
+            const float df = float(w_forget[row_base + b].d);
+            float gd = 0.0;
+            float fd = 0.0;
+            [[unroll]] for (uint j = 0u; j < 8u; ++j) {
+                float x0 = s_gate[x_base + 2u * j];
+                float x1 = s_gate[x_base + 2u * j + 1u];
+
+                int gq16 = int(w_gain[row_base + b].qs[q_off + j]);
+                gd += float(bitfieldExtract(gq16, 0, 8)) * x0 + float(bitfieldExtract(gq16, 8, 8)) * x1;
+
+                int fq16 = int(w_forget[row_base + b].qs[q_off + j]);
+                fd += float(bitfieldExtract(fq16, 0, 8)) * x0 + float(bitfieldExtract(fq16, 8, 8)) * x1;
+            }
+            g_acc += dg * gd;
+            f_acc += df * fd;
+        }
+    }
+
+    g_acc += subgroupShuffleXor(g_acc, 1u);
+    g_acc += subgroupShuffleXor(g_acc, 2u);
+    f_acc += subgroupShuffleXor(f_acc, 1u);
+    f_acc += subgroupShuffleXor(f_acc, 2u);
+
+    if (lane4 == 0u && r < D) {
+        const float g = tanh(g_acc);
+        const float f = tanh(f_acc);
+        const float c = cur[off_cur + r];
+        const float m = msg[off_msg + r];
+        dst[off_d + r] = c - f * c + g * m;
+    }
+}
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/depth_mix.comp b/ggml/src/ggml-vulkan/vulkan-shaders/depth_mix.comp
new file mode 100644
index 0000000..ce4d1af
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/depth_mix.comp
@@ -0,0 +1,179 @@
+#version 450
+
+#extension GL_EXT_control_flow_attributes : require
+#extension GL_KHR_shader_subgroup_basic : require
+#extension GL_KHR_shader_subgroup_arithmetic : require
+
+layout(constant_id = 0) const bool HAS_CUR = false;
+
+layout(local_size_x = 512, local_size_y = 1, local_size_z = 1) in;
+
+layout(binding = 0) readonly buffer States { vec4 states[]; };
+layout(binding = 1) readonly buffer Cur    { vec4 cur[]; };
+layout(binding = 2) readonly buffer Query  { vec4 query[]; };
+layout(binding = 3) writeonly buffer Dst   { vec4 dst[]; };
+
+layout(push_constant) uniform PushConstants {
+    uint D4;
+    uint K_in;
+    uint Q;
+    uint n_tokens;
+    uint off_states4;
+    uint off_cur4;
+    uint off_query4;
+    uint off_d4;
+    float eps;
+    float scale;
+};
+
+// [0..6] = dot(states[k], q), [7] = dot(cur, q), [8] = dot(cur, cur)
+shared float s_red[9][32];
+
+void main() {
+    const uint t = gl_WorkGroupID.x;
+    const uint q = gl_WorkGroupID.y;
+    if (t >= n_tokens || q >= Q) {
+        return;
+    }
+
+    const uint tid = gl_LocalInvocationID.x;
+    const uint st_base  = off_states4 + t * K_in * D4;
+    const uint cur_base = off_cur4 + t * D4;
+    const uint q_base   = off_query4 + q * D4;
+    const uint dst_base = off_d4 + (t * Q + q) * D4;
+
+    vec4 s0 = vec4(0.0), s1 = vec4(0.0), s2 = vec4(0.0), s3 = vec4(0.0);
+    vec4 s4 = vec4(0.0), s5 = vec4(0.0), s6 = vec4(0.0), c0 = vec4(0.0);
+
+    float a0 = 0.0, a1 = 0.0, a2 = 0.0, a3 = 0.0;
+    float a4 = 0.0, a5 = 0.0, a6 = 0.0, acur = 0.0, sq = 0.0;
+
+    if (tid < D4) {
+        vec4 qv = query[q_base + tid];
+        if (K_in > 0u) { s0 = states[st_base + 0u * D4 + tid]; a0 = dot(s0, qv); }
+        if (K_in > 1u) { s1 = states[st_base + 1u * D4 + tid]; a1 = dot(s1, qv); }
+        if (K_in > 2u) { s2 = states[st_base + 2u * D4 + tid]; a2 = dot(s2, qv); }
+        if (K_in > 3u) { s3 = states[st_base + 3u * D4 + tid]; a3 = dot(s3, qv); }
+        if (K_in > 4u) { s4 = states[st_base + 4u * D4 + tid]; a4 = dot(s4, qv); }
+        if (K_in > 5u) { s5 = states[st_base + 5u * D4 + tid]; a5 = dot(s5, qv); }
+        if (K_in > 6u) { s6 = states[st_base + 6u * D4 + tid]; a6 = dot(s6, qv); }
+        if (HAS_CUR)   { c0 = cur[cur_base + tid]; sq = dot(c0, c0); acur = dot(c0, qv); }
+    }
+
+    for (uint d = tid + 512u; d < D4; d += 512u) {
+        vec4 qv = query[q_base + d];
+        if (K_in > 0u) a0 += dot(states[st_base + 0u * D4 + d], qv);
+        if (K_in > 1u) a1 += dot(states[st_base + 1u * D4 + d], qv);
+        if (K_in > 2u) a2 += dot(states[st_base + 2u * D4 + d], qv);
+        if (K_in > 3u) a3 += dot(states[st_base + 3u * D4 + d], qv);
+        if (K_in > 4u) a4 += dot(states[st_base + 4u * D4 + d], qv);
+        if (K_in > 5u) a5 += dot(states[st_base + 5u * D4 + d], qv);
+        if (K_in > 6u) a6 += dot(states[st_base + 6u * D4 + d], qv);
+        if (HAS_CUR) {
+            vec4 cv = cur[cur_base + d];
+            sq += dot(cv, cv);
+            acur += dot(cv, qv);
+        }
+    }
+
+    const uint sg_id = gl_SubgroupID;
+    const uint n_sg  = gl_NumSubgroups;
+    if (K_in > 0u) a0 = subgroupAdd(a0);
+    if (K_in > 1u) a1 = subgroupAdd(a1);
+    if (K_in > 2u) a2 = subgroupAdd(a2);
+    if (K_in > 3u) a3 = subgroupAdd(a3);
+    if (K_in > 4u) a4 = subgroupAdd(a4);
+    if (K_in > 5u) a5 = subgroupAdd(a5);
+    if (K_in > 6u) a6 = subgroupAdd(a6);
+    if (HAS_CUR) {
+        acur = subgroupAdd(acur);
+        sq   = subgroupAdd(sq);
+    }
+
+    if (n_sg > 1u) {
+        if (subgroupElect()) {
+            if (K_in > 0u) s_red[0][sg_id] = a0;
+            if (K_in > 1u) s_red[1][sg_id] = a1;
+            if (K_in > 2u) s_red[2][sg_id] = a2;
+            if (K_in > 3u) s_red[3][sg_id] = a3;
+            if (K_in > 4u) s_red[4][sg_id] = a4;
+            if (K_in > 5u) s_red[5][sg_id] = a5;
+            if (K_in > 6u) s_red[6][sg_id] = a6;
+            if (HAS_CUR) {
+                s_red[7][sg_id] = acur;
+                s_red[8][sg_id] = sq;
+            }
+        }
+        barrier();
+        a0 = 0.0; a1 = 0.0; a2 = 0.0; a3 = 0.0;
+        a4 = 0.0; a5 = 0.0; a6 = 0.0; acur = 0.0; sq = 0.0;
+        for (uint s = 0u; s < n_sg; ++s) {
+            if (K_in > 0u) a0 += s_red[0][s];
+            if (K_in > 1u) a1 += s_red[1][s];
+            if (K_in > 2u) a2 += s_red[2][s];
+            if (K_in > 3u) a3 += s_red[3][s];
+            if (K_in > 4u) a4 += s_red[4][s];
+            if (K_in > 5u) a5 += s_red[5][s];
+            if (K_in > 6u) a6 += s_red[6][s];
+            if (HAS_CUR) {
+                acur += s_red[7][s];
+                sq   += s_red[8][s];
+            }
+        }
+    }
+
+    const float rms_inv = HAS_CUR ? inversesqrt(sq / float(D4 * 4u) + eps) : 1.0;
+
+    const float NEG_INF = -3.402823466e+38;
+    float mx = NEG_INF;
+    if (K_in > 0u) { a0 *= scale; mx = max(mx, a0); }
+    if (K_in > 1u) { a1 *= scale; mx = max(mx, a1); }
+    if (K_in > 2u) { a2 *= scale; mx = max(mx, a2); }
+    if (K_in > 3u) { a3 *= scale; mx = max(mx, a3); }
+    if (K_in > 4u) { a4 *= scale; mx = max(mx, a4); }
+    if (K_in > 5u) { a5 *= scale; mx = max(mx, a5); }
+    if (K_in > 6u) { a6 *= scale; mx = max(mx, a6); }
+    if (HAS_CUR)   { acur = acur * rms_inv * scale; mx = max(mx, acur); }
+
+    float sm = 0.0;
+    float w0 = 0.0, w1 = 0.0, w2 = 0.0, w3 = 0.0;
+    float w4 = 0.0, w5 = 0.0, w6 = 0.0, wcur = 0.0;
+    if (K_in > 0u) { w0 = exp(a0 - mx); sm += w0; }
+    if (K_in > 1u) { w1 = exp(a1 - mx); sm += w1; }
+    if (K_in > 2u) { w2 = exp(a2 - mx); sm += w2; }
+    if (K_in > 3u) { w3 = exp(a3 - mx); sm += w3; }
+    if (K_in > 4u) { w4 = exp(a4 - mx); sm += w4; }
+    if (K_in > 5u) { w5 = exp(a5 - mx); sm += w5; }
+    if (K_in > 6u) { w6 = exp(a6 - mx); sm += w6; }
+    if (HAS_CUR)   { wcur = exp(acur - mx); sm += wcur; }
+
+    const float inv_sm = 1.0 / sm;
+    w0 *= inv_sm; w1 *= inv_sm; w2 *= inv_sm; w3 *= inv_sm;
+    w4 *= inv_sm; w5 *= inv_sm; w6 *= inv_sm; wcur *= inv_sm * rms_inv;
+
+    if (tid < D4) {
+        vec4 acc = vec4(0.0);
+        if (K_in > 0u) acc += w0 * s0;
+        if (K_in > 1u) acc += w1 * s1;
+        if (K_in > 2u) acc += w2 * s2;
+        if (K_in > 3u) acc += w3 * s3;
+        if (K_in > 4u) acc += w4 * s4;
+        if (K_in > 5u) acc += w5 * s5;
+        if (K_in > 6u) acc += w6 * s6;
+        if (HAS_CUR)   acc += wcur * c0;
+        dst[dst_base + tid] = acc;
+    }
+
+    for (uint d = tid + 512u; d < D4; d += 512u) {
+        vec4 acc = vec4(0.0);
+        if (K_in > 0u) acc += w0 * states[st_base + 0u * D4 + d];
+        if (K_in > 1u) acc += w1 * states[st_base + 1u * D4 + d];
+        if (K_in > 2u) acc += w2 * states[st_base + 2u * D4 + d];
+        if (K_in > 3u) acc += w3 * states[st_base + 3u * D4 + d];
+        if (K_in > 4u) acc += w4 * states[st_base + 4u * D4 + d];
+        if (K_in > 5u) acc += w5 * states[st_base + 5u * D4 + d];
+        if (K_in > 6u) acc += w6 * states[st_base + 6u * D4 + d];
+        if (HAS_CUR)   acc += wcur * cur[cur_base + d];
+        dst[dst_base + d] = acc;
+    }
+}
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/l2_clip.comp b/ggml/src/ggml-vulkan/vulkan-shaders/l2_clip.comp
new file mode 100644
index 0000000..dd7732a
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/l2_clip.comp
@@ -0,0 +1,84 @@
+#version 450
+
+#extension GL_EXT_control_flow_attributes : enable
+#extension GL_KHR_shader_subgroup_basic : enable
+#extension GL_KHR_shader_subgroup_arithmetic : enable
+
+// Fused L2-norm row clip with optional per-element scale:
+//   y = x * (has_scale ? s : 1)
+//   norm = sqrt(sum_row(y^2)) + eps
+//   dst = y * clamp(threshold / norm, cmin, cmax)
+layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
+
+layout(binding = 0) readonly  buffer A { float data_a[]; };
+layout(binding = 1) readonly  buffer B { float data_b[]; };
+layout(binding = 2) writeonly buffer D { float data_d[]; };
+
+layout(push_constant) uniform parameter {
+    uint ne0;       // row length (e.g. 128 or 16)
+    uint ne1;       // heads per token
+    uint nrows;     // total rows = ne1 * ne2 * ne3
+    uint has_scale; // 0 or 1; scale has shape [ne0, ne1]
+    float eps;
+    float threshold;
+    float cmin;
+    float cmax;
+} p;
+
+shared float sumsh[128];
+
+void main() {
+    const uint row = gl_WorkGroupID.x;
+    if (row >= p.nrows) {
+        return;
+    }
+    const uint tid = gl_LocalInvocationID.x;
+    const uint row_off = row * p.ne0;
+    const uint scale_off = (row % p.ne1) * p.ne0;
+
+    float partial = 0.0f;
+    float cached = 0.0f;
+    if (p.ne0 <= 128u) {
+        if (tid < p.ne0) {
+            cached = data_a[row_off + tid];
+            if (p.has_scale != 0u) {
+                cached *= data_b[scale_off + tid];
+            }
+            partial = cached * cached;
+        }
+    } else {
+        for (uint col = tid; col < p.ne0; col += 128u) {
+            float v = data_a[row_off + col];
+            if (p.has_scale != 0u) {
+                v *= data_b[scale_off + col];
+            }
+            partial += v * v;
+        }
+    }
+
+    sumsh[tid] = partial;
+    barrier();
+    [[unroll]] for (uint s = 64u; s > 0u; s >>= 1u) {
+        if (tid < s) {
+            partial += sumsh[tid + s];
+            sumsh[tid] = partial;
+        }
+        barrier();
+    }
+
+    const float factor = clamp(p.threshold / (sqrt(sumsh[0]) + p.eps), p.cmin, p.cmax);
+
+    if (p.ne0 <= 128u) {
+        if (tid < p.ne0) {
+            data_d[row_off + tid] = cached * factor;
+        }
+    } else {
+        for (uint col = tid; col < p.ne0; col += 128u) {
+            float v = data_a[row_off + col];
+            if (p.has_scale != 0u) {
+                v *= data_b[scale_off + col];
+            }
+            data_d[row_off + col] = v * factor;
+        }
+    }
+}
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/rel_bias_mask.comp b/ggml/src/ggml-vulkan/vulkan-shaders/rel_bias_mask.comp
new file mode 100644
index 0000000..dc592ba
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/rel_bias_mask.comp
@@ -0,0 +1,49 @@
+#version 450
+
+#extension GL_EXT_shader_16bit_storage : require
+#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
+
+// Fused Inkling relative-position bias gather + permute + mask add + F16 cast:
+//   table     : F32 [n_head, n_buckets, n_tokens]
+//   rel_pos   : I32 [n_kv, n_tokens]
+//   base_mask : F32 [n_kv, n_per_stream, 1, n_stream]
+//   dst       : F16 [n_kv, n_per_stream, n_head, n_stream]
+layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+layout(binding = 0) readonly  buffer Table    { float     data_table[]; };
+layout(binding = 1) readonly  buffer RelPos   { int       data_pos[]; };
+layout(binding = 2) readonly  buffer BaseMask { float     data_mask[]; };
+layout(binding = 3) writeonly buffer Dst      { float16_t data_d[]; };
+
+layout(push_constant) uniform parameter {
+    uint n_kv;
+    uint n_head;
+    uint n_buckets;
+    uint n_per_stream;
+    uint n_stream;
+    uint mask_nb1; // in floats
+    uint mask_nb3; // in floats
+    uint off_table;
+    uint off_pos;
+    uint off_mask;
+    uint off_d;
+} p;
+
+void main() {
+    const uint kv_idx = gl_GlobalInvocationID.x;
+    const uint head_idx = gl_WorkGroupID.y;
+    const uint tok_idx = gl_WorkGroupID.z;
+    if (kv_idx >= p.n_kv || head_idx >= p.n_head) {
+        return;
+    }
+
+    const uint s = tok_idx / p.n_per_stream;
+    const uint t = tok_idx % p.n_per_stream;
+
+    const uint bucket = uint(data_pos[p.off_pos + tok_idx * p.n_kv + kv_idx]);
+    const float bias = data_table[p.off_table + (tok_idx * p.n_buckets + bucket) * p.n_head + head_idx];
+    const float mask = data_mask[p.off_mask + s * p.mask_nb3 + t * p.mask_nb1 + kv_idx];
+
+    const uint d_idx = ((s * p.n_head + head_idx) * p.n_per_stream + t) * p.n_kv + kv_idx;
+    data_d[p.off_d + d_idx] = float16_t(bias + mask);
+}
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/rel_bias_mask_direct.comp b/ggml/src/ggml-vulkan/vulkan-shaders/rel_bias_mask_direct.comp
new file mode 100644
index 0000000..3aa4913
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/rel_bias_mask_direct.comp
@@ -0,0 +1,73 @@
+#version 450
+
+#extension GL_EXT_control_flow_attributes : require
+#extension GL_EXT_shader_16bit_storage : require
+#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
+
+layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
+
+layout(binding = 0) readonly buffer Bias { float bias[]; };
+layout(binding = 1) readonly buffer Rcur { float rcur[]; };
+layout(binding = 2) readonly buffer Pos  { int rel_pos[]; };
+layout(binding = 3) readonly buffer Mask { float base_mask[]; };
+layout(binding = 4) writeonly buffer Dst { float16_t dst[]; };
+
+layout(push_constant) uniform PushConstants {
+    uint n_kv;
+    uint n_head;
+    uint n_rel;
+    uint n_extent;
+    uint off_bias;
+    uint off_r;
+    uint off_pos;
+    uint off_mask;
+    uint off_d;
+};
+
+shared float s_R[4 * 64];
+
+void main() {
+    const uint tid = gl_LocalInvocationID.x;
+    const uint h_base = gl_WorkGroupID.y * 4u;
+    const uint h_cnt = min(4u, n_head - h_base);
+
+    for (uint i = tid; i < h_cnt * n_rel; i += 64u) {
+        const uint lh = i / n_rel;
+        const uint r = i % n_rel;
+        s_R[lh * 64u + r] = rcur[off_r + (h_base + lh) * n_rel + r];
+    }
+    barrier();
+
+    const uint kv = gl_WorkGroupID.x * 64u + tid;
+    if (kv >= n_kv) {
+        return;
+    }
+
+    const float m = base_mask[off_mask + kv];
+    const uint pos = uint(rel_pos[off_pos + kv]);
+
+    if (pos < n_extent) {
+        float acc0 = 0.0;
+        float acc1 = 0.0;
+        float acc2 = 0.0;
+        float acc3 = 0.0;
+        const uint b_off = off_bias + pos * n_rel;
+        for (uint r = 0u; r < n_rel; ++r) {
+            const float bv = bias[b_off + r];
+            acc0 += bv * s_R[0u * 64u + r];
+            if (h_cnt > 1u) acc1 += bv * s_R[1u * 64u + r];
+            if (h_cnt > 2u) acc2 += bv * s_R[2u * 64u + r];
+            if (h_cnt > 3u) acc3 += bv * s_R[3u * 64u + r];
+        }
+        dst[off_d + (h_base + 0u) * n_kv + kv] = float16_t(m + acc0);
+        if (h_cnt > 1u) dst[off_d + (h_base + 1u) * n_kv + kv] = float16_t(m + acc1);
+        if (h_cnt > 2u) dst[off_d + (h_base + 2u) * n_kv + kv] = float16_t(m + acc2);
+        if (h_cnt > 3u) dst[off_d + (h_base + 3u) * n_kv + kv] = float16_t(m + acc3);
+    } else {
+        const float16_t mh = float16_t(m);
+        dst[off_d + (h_base + 0u) * n_kv + kv] = mh;
+        if (h_cnt > 1u) dst[off_d + (h_base + 1u) * n_kv + kv] = mh;
+        if (h_cnt > 2u) dst[off_d + (h_base + 2u) * n_kv + kv] = mh;
+        if (h_cnt > 3u) dst[off_d + (h_base + 3u) * n_kv + kv] = mh;
+    }
+}
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/situ.comp b/ggml/src/ggml-vulkan/vulkan-shaders/situ.comp
new file mode 100644
index 0000000..9be4ce6
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/situ.comp
@@ -0,0 +1,51 @@
+#version 450
+
+// Fused SiTU gated activation on strided gate/up views:
+//   dst = out_scale * tanh(gate * inv_beta) * sigmoid(gate) * tanh(up * inv_lb)
+layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+layout(binding = 0) readonly  buffer Gate { float data_g[]; };
+layout(binding = 1) readonly  buffer Up   { float data_u[]; };
+layout(binding = 2) writeonly buffer Dst  { float data_d[]; };
+
+layout(push_constant) uniform parameter {
+    uint ne0;
+    uint ne1;
+    uint ne2;
+    uint ne3;
+    uint nb01; // in floats
+    uint nb02;
+    uint nb03;
+    uint off_g; // in floats
+    uint nb11;
+    uint nb12;
+    uint nb13;
+    uint off_u; // in floats
+    uint off_d; // in floats
+    float inv_beta;
+    float inv_lb; // <= 0 means no up tanh
+    float out_scale;
+} p;
+
+void main() {
+    const uint idx = gl_GlobalInvocationID.x;
+    const uint total = p.ne0 * p.ne1 * p.ne2 * p.ne3;
+    if (idx >= total) {
+        return;
+    }
+
+    const uint i0 = idx % p.ne0;
+    const uint r1 = idx / p.ne0;
+    const uint i1 = r1 % p.ne1;
+    const uint r2 = r1 / p.ne1;
+    const uint i2 = r2 % p.ne2;
+    const uint i3 = r2 / p.ne2;
+
+    const float g = data_g[p.off_g + i3 * p.nb03 + i2 * p.nb02 + i1 * p.nb01 + i0];
+    const float u = data_u[p.off_u + i3 * p.nb13 + i2 * p.nb12 + i1 * p.nb11 + i0];
+
+    const float sig = 1.0f / (1.0f + exp(-g));
+    const float act = tanh(g * p.inv_beta) * sig;
+    const float upv = p.inv_lb > 0.0f ? tanh(u * p.inv_lb) : u;
+    data_d[p.off_d + idx] = p.out_scale * (act * upv);
+}
