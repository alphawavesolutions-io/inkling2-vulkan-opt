+static bool ggml_vk_can_fuse_control_down_q8_0(const ggml_backend_vk_context * ctx, const struct ggml_cgraph * cgraph, int node_idx) {
+    static const bool disable_cd = getenv("GGML_VK_NO_CTRL_DOWN") != nullptr;
+    if (disable_cd || !ctx->device->fp16 || !ctx->device->subgroup_arithmetic || ctx->device->subgroup_size < 16 ||
