+void ggml_vk_l2_clip_dispatch_fused(ggml_backend_vk_context * ctx, vk_context& subctx, ggml_cgraph * cgraph, int node_idx, bool has_scale) {
+    const int off = has_scale ? 1 : 0;
+    const ggml_tensor * x      = has_scale ? cgraph->nodes[node_idx]->src[0] : cgraph->nodes[node_idx]->src[0];
+    const ggml_tensor * scale  = has_scale ? cgraph->nodes[node_idx]->src[1] : x;
+    const ggml_tensor * sb     = cgraph->nodes[node_idx + off + 3];
+    const ggml_tensor * fill   = cgraph->nodes[node_idx + off + 4];
+    const ggml_tensor * clmp   = cgraph->nodes[node_idx + off + 6];
+    ggml_tensor *       dst    = cgraph->nodes[node_idx + off + 7];
+
+    vk_pipeline pipeline = ctx->device->pipeline_l2_clip_f32;
+    ggml_pipeline_request_descriptor_sets(ctx, pipeline, 1);
+
+    vk_subbuffer x_buf   = ggml_vk_tensor_subbuffer(ctx, x);
+    vk_subbuffer s_buf   = ggml_vk_tensor_subbuffer(ctx, scale);
+    vk_subbuffer dst_buf = ggml_vk_tensor_subbuffer(ctx, dst);
+
+    const uint32_t ne0   = (uint32_t)x->ne[0];
+    const uint32_t ne1   = (uint32_t)x->ne[1];
+    const uint32_t nrows = (uint32_t)ggml_nrows(x);
+    vk_op_l2_clip_push_constants pc {
+        ne0, ne1, nrows, has_scale ? 1u : 0u,
+        ggml_get_op_params_f32(sb, 1),
+        ggml_get_op_params_f32(fill, 0),
+        ggml_get_op_params_f32(clmp, 0),
+        ggml_get_op_params_f32(clmp, 1),
+    };
+    ggml_vk_dispatch_pipeline(ctx, subctx, pipeline, { x_buf, s_buf, dst_buf }, pc, { nrows, 1, 1 });
+}
