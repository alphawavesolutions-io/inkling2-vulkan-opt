diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/ssm_conv_decode.comp b/ggml/src/ggml-vulkan/vulkan-shaders/ssm_conv_decode.comp
new file mode 100644
index 0000000..5b6c9c3
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/ssm_conv_decode.comp
@@ -0,0 +1,89 @@
+#version 450
+
+#extension GL_EXT_control_flow_attributes : require
+
+layout(constant_id = 0) const bool HAS_DYNAMIC = false;
+
+layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
+
+layout(binding = 0) readonly buffer Past     { float past[]; };
+layout(binding = 1) readonly buffer Cur      { float cur[]; };
+layout(binding = 2) readonly buffer Weight   { float weight[]; };
+layout(binding = 3) readonly buffer Dyn      { float dyn[]; };
+layout(binding = 4) writeonly buffer State   { float state_dst[]; };
+layout(binding = 5) writeonly buffer Dst     { float dst[]; };
+
+layout(push_constant) uniform PushConstants {
+    uint C;
+    uint n_conv;
+    uint head_dim;
+    uint past_nb1;
+    uint off_past;
+    uint off_cur;
+    uint off_w;
+    uint off_dyn;
+    uint off_state;
+    uint off_d;
+    float res_scale;
+};
+
+void main() {
+    const uint c = gl_GlobalInvocationID.x;
+    if (c >= C) {
+        return;
+    }
+
+    const uint n_past = n_conv - 1u;
+    const uint p_base = off_past + c * past_nb1;
+    const uint s_base = off_state + c * n_past;
+    const uint w_base = off_w + c * n_conv;
+    const float xc = cur[off_cur + c];
+
+    float sum = 0.0;
+    if (n_conv == 4u) {
+        float p0 = past[p_base + 0u];
+        float p1 = past[p_base + 1u];
+        float p2 = past[p_base + 2u];
+
+        state_dst[s_base + 0u] = p1;
+        state_dst[s_base + 1u] = p2;
+        state_dst[s_base + 2u] = xc;
+
+        sum = weight[w_base + 0u] * p0
+            + weight[w_base + 1u] * p1
+            + weight[w_base + 2u] * p2
+            + weight[w_base + 3u] * xc;
+
+        if (HAS_DYNAMIC) {
+            const uint d_base = off_dyn + (c / head_dim) * 4u;
+            sum += dyn[d_base + 0u] * xc
+                 + dyn[d_base + 1u] * p2
+                 + dyn[d_base + 2u] * p1
+                 + dyn[d_base + 3u] * p0;
+        }
+    } else {
+        float p_prev = past[p_base + 0u];
+        sum = weight[w_base + 0u] * p_prev;
+        if (HAS_DYNAMIC) {
+            const uint d_base = off_dyn + (c / head_dim) * n_conv;
+            sum += dyn[d_base + (n_conv - 1u)] * p_prev;
+        }
+        for (uint i = 1u; i < n_past; ++i) {
+            float pi = past[p_base + i];
+            state_dst[s_base + i - 1u] = pi;
+            sum += weight[w_base + i] * pi;
+            if (HAS_DYNAMIC) {
+                const uint d_base = off_dyn + (c / head_dim) * n_conv;
+                sum += dyn[d_base + (n_conv - 1u - i)] * pi;
+            }
+        }
+        state_dst[s_base + n_past - 1u] = xc;
+        sum += weight[w_base + n_past] * xc;
+        if (HAS_DYNAMIC) {
+            const uint d_base = off_dyn + (c / head_dim) * n_conv;
+            sum += dyn[d_base + 0u] * xc;
+        }
+    }
+
+    dst[off_d + c] = (xc + sum) * res_scale;
+}
