+void ggml_vk_ssm_conv_decode_dispatch_fused(ggml_backend_vk_context * ctx, vk_context& subctx, const ggml_cgraph * cgraph, int node_idx, bool has_dyn) {
+    const ggml_tensor * concat    = cgraph->nodes[node_idx + 0];
+    const ggml_tensor * state_dst = cgraph->nodes[node_idx + 2];
+    const ggml_tensor * conv      = cgraph->nodes[node_idx + 3];
+    const ggml_tensor * add       = cgraph->nodes[node_idx + (has_dyn ? 21 : 5)];
+    const ggml_tensor * scale     = cgraph->nodes[node_idx + (has_dyn ? 22 : 6)];
+
+    const ggml_tensor * past   = concat->src[0];
+    const ggml_tensor * cur    = add->src[0];
+    const ggml_tensor * weight = conv->src[1];
+    const ggml_tensor * dyn_rs = has_dyn ? cgraph->nodes[node_idx + 9]->src[1]->src[0] : nullptr;
+    const ggml_tensor * dyn    = has_dyn ? dyn_rs->src[0] : weight;
+
+    vk_pipeline pipeline = has_dyn ? ctx->device->pipeline_ssm_conv_decode_dyn_f32 : ctx->device->pipeline_ssm_conv_decode_f32;
+    ggml_pipeline_request_descriptor_sets(ctx, pipeline, 1);
+
+    vk_subbuffer p_buf  = ggml_vk_tensor_subbuffer(ctx, past,      true);
+    vk_subbuffer c_buf  = ggml_vk_tensor_subbuffer(ctx, cur,       true);
+    vk_subbuffer w_buf  = ggml_vk_tensor_subbuffer(ctx, weight,    true);
+    vk_subbuffer dy_buf = ggml_vk_tensor_subbuffer(ctx, dyn,       true);
+    vk_subbuffer s_buf  = ggml_vk_tensor_subbuffer(ctx, state_dst, true);
+    vk_subbuffer d_buf  = ggml_vk_tensor_subbuffer(ctx, scale,     true);
+
+    const uint32_t C        = (uint32_t)cur->ne[0];
+    const uint32_t n_conv   = (uint32_t)weight->ne[0];
+    const uint32_t head_dim = has_dyn ? (uint32_t)(C / dyn_rs->ne[1]) : 0u;
+    const float res_scale   = ggml_get_op_params_f32(scale, 0);
+    vk_op_ssm_conv_decode_push_constants pc {
+        C, n_conv, head_dim,
+        (uint32_t)(past->nb[1] / sizeof(float)),
+        (uint32_t)(get_misalign_bytes(ctx, past)      / sizeof(float)),
+        (uint32_t)(get_misalign_bytes(ctx, cur)       / sizeof(float)),
+        (uint32_t)(get_misalign_bytes(ctx, weight)    / sizeof(float)),
+        (uint32_t)(get_misalign_bytes(ctx, dyn)       / sizeof(float)),
+        (uint32_t)(get_misalign_bytes(ctx, state_dst) / sizeof(float)),
+        (uint32_t)(get_misalign_bytes(ctx, scale)     / sizeof(float)),
+        res_scale,
+    };
+    ggml_vk_dispatch_pipeline(ctx, subctx, pipeline, { p_buf, c_buf, w_buf, dy_buf, s_buf, d_buf }, pc, { C, 1, 1 });
+}
