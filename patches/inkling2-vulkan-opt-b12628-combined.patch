+static bool ggml_vk_can_fuse_control_apply(const ggml_backend_vk_context * ctx, const struct ggml_cgraph * cgraph, int node_idx) {
+    GGML_UNUSED(ctx);
+    const ggml_tensor * tanh_f = cgraph->nodes[node_idx + 0];
+    const ggml_tensor * mul0   = cgraph->nodes[node_idx + 1];
+    const ggml_tensor * sub    = cgraph->nodes[node_idx + 2];
+    const ggml_tensor * tanh_g = cgraph->nodes[node_idx + 3];
+    const ggml_tensor * mul1   = cgraph->nodes[node_idx + 4];
+    const ggml_tensor * add    = cgraph->nodes[node_idx + 5];
+
+    if (ggml_get_unary_op(tanh_f) != GGML_UNARY_OP_TANH ||
+        ggml_get_unary_op(tanh_g) != GGML_UNARY_OP_TANH) {
+        return false;
+    }
+    const ggml_tensor * cur = sub->src[0];
+    if (mul0->src[1] != cur) {
+        return false;
+    }
+    const ggml_tensor * msg        = mul1->src[1];
+    const ggml_tensor * gain_raw   = tanh_g->src[0];
+    const ggml_tensor * forget_raw = tanh_f->src[0];
+    for (const ggml_tensor * t : { cur, msg, gain_raw, forget_raw, add }) {
+        if (t->type != GGML_TYPE_F32 || !ggml_is_contiguous(t) || !ggml_are_same_shape(t, add)) {
+            return false;
+        }
+    }
+    return true;
+}
