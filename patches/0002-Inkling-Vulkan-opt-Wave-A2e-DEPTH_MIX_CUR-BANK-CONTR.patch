+
+shared float s_sg[4];
+
+float wg_sum(float v) {
+    float sg = subgroupAdd(v);
+    if (gl_NumSubgroups == 1u) {
+        return sg;
+    }
+    if (subgroupElect()) {
+        s_sg[gl_SubgroupID] = sg;
+    }
+    barrier();
+    float tot = 0.0;
+    for (uint s = 0u; s < gl_NumSubgroups; ++s) {
+        tot += s_sg[s];
+    }
+    barrier();
+    return tot;
+}
