+void ggml_vk_depth_mix_dispatch_fused(ggml_backend_vk_context * ctx, vk_context& subctx, const ggml_cgraph * cgraph, int node_idx, bool has_cur) {
+    const ggml_tensor * states = nullptr;
+    const ggml_tensor * cur    = nullptr;
+    const ggml_tensor * query  = nullptr;
+    const ggml_tensor * sm     = nullptr;
+    const ggml_tensor * dst    = nullptr;
+    float eps = 1e-6f;
+
+    if (has_cur) {
+        const ggml_tensor * rms    = cgraph->nodes[node_idx + 0];
+        const ggml_tensor * concat = cgraph->nodes[node_idx + 2];
+        const ggml_tensor * q_op   = cgraph->nodes[node_idx + 5];
+        sm  = cgraph->nodes[node_idx + 7];
+        dst = cgraph->nodes[node_idx + 8];
+        states = concat->src[0];
+        cur    = rms->src[0];
+        query  = q_op->src[0];
+        eps    = ggml_get_op_params_f32(rms, 0);
+    } else {
+        const bool has_rep = cgraph->nodes[node_idx + 0]->op == GGML_OP_REPEAT;
+        const int off = has_rep ? 1 : 0;
+        const ggml_tensor * mm0 = cgraph->nodes[node_idx + off + 0];
+        sm  = cgraph->nodes[node_idx + off + 1];
+        dst = cgraph->nodes[node_idx + off + 2];
+        states = mm0->src[0];
+        cur    = states;
+        query  = has_rep ? cgraph->nodes[node_idx + 0]->src[0] : mm0->src[1];
+    }
+
+    vk_pipeline pipeline = has_cur ? ctx->device->pipeline_depth_mix_cur_f32 : ctx->device->pipeline_depth_mix_bank_f32;
+    ggml_pipeline_request_descriptor_sets(ctx, pipeline, 1);
+
+    vk_subbuffer st_buf = ggml_vk_tensor_subbuffer(ctx, states, true);
+    vk_subbuffer c_buf  = ggml_vk_tensor_subbuffer(ctx, cur,    true);
+    vk_subbuffer q_buf  = ggml_vk_tensor_subbuffer(ctx, query,  true);
+    vk_subbuffer d_buf  = ggml_vk_tensor_subbuffer(ctx, dst,    true);
+
+    const uint32_t D4       = (uint32_t)(states->ne[0] / 4);
+    const uint32_t K_in     = (uint32_t)states->ne[1];
+    const uint32_t Q        = (uint32_t)dst->ne[1];
+    const uint32_t n_tokens = (uint32_t)dst->ne[2];
+    const float scale       = ggml_get_op_params_f32(sm, 0);
+    vk_op_depth_mix_push_constants pc {
+        D4, K_in, Q, n_tokens,
+        (uint32_t)(get_misalign_bytes(ctx, states) / (4 * sizeof(float))),
+        (uint32_t)(get_misalign_bytes(ctx, cur)    / (4 * sizeof(float))),
+        (uint32_t)(get_misalign_bytes(ctx, query)  / (4 * sizeof(float))),
+        (uint32_t)(get_misalign_bytes(ctx, dst)    / (4 * sizeof(float))),
+        eps, scale,
+    };
+    ggml_vk_dispatch_pipeline(ctx, subctx, pipeline, { st_buf, c_buf, q_buf, d_buf }, pc, { n_tokens, Q, 1 });
+}
