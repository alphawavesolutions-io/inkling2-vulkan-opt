+static bool ggml_vk_can_fuse_situ(const ggml_backend_vk_context * ctx, const struct ggml_cgraph * cgraph, int node_idx) {
+    GGML_UNUSED(ctx);
+    const ggml_tensor * scale0 = cgraph->nodes[node_idx + 0];
+    const ggml_tensor * tanh0  = cgraph->nodes[node_idx + 1];
+    const ggml_tensor * sig    = cgraph->nodes[node_idx + 2];
+    const ggml_tensor * scale1 = cgraph->nodes[node_idx + 4];
+    const ggml_tensor * tanh1  = cgraph->nodes[node_idx + 5];
+    const ggml_tensor * scale2 = cgraph->nodes[node_idx + 7];
+
+    if (ggml_get_unary_op(tanh0) != GGML_UNARY_OP_TANH ||
+        ggml_get_unary_op(sig)   != GGML_UNARY_OP_SIGMOID ||
+        ggml_get_unary_op(tanh1) != GGML_UNARY_OP_TANH) {
+        return false;
+    }
+    if (ggml_get_op_params_f32(scale0, 1) != 0.0f ||
+        ggml_get_op_params_f32(scale1, 1) != 0.0f ||
+        ggml_get_op_params_f32(scale2, 1) != 0.0f) {
+        return false;
+    }
+    const ggml_tensor * gate = scale0->src[0];
+    const ggml_tensor * up   = scale1->src[0];
+    if (sig->src[0] != gate) {
+        return false;
+    }
+    if (gate->type != GGML_TYPE_F32 || up->type != GGML_TYPE_F32 || scale2->type != GGML_TYPE_F32 ||
+        gate->nb[0] != sizeof(float) || up->nb[0] != sizeof(float) || !ggml_is_contiguous(scale2) ||
+        !ggml_are_same_shape(gate, up) || !ggml_are_same_shape(gate, scale2)) {
+        return false;
+    }
+    return true;
+}
