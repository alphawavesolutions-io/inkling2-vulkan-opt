+void ggml_vk_rel_bias_mask_direct_dispatch_fused(ggml_backend_vk_context * ctx, vk_context& subctx, const ggml_cgraph * cgraph, int node_idx) {
+    const ggml_tensor * pad      = cgraph->nodes[node_idx + 0];
+    const ggml_tensor * mm       = cgraph->nodes[node_idx + 1];
+    const ggml_tensor * get_rows = cgraph->nodes[node_idx + 4];
+    const ggml_tensor * add      = cgraph->nodes[node_idx + 8];
+    const ggml_tensor * dst      = cgraph->nodes[node_idx + 9];
+
+    const ggml_tensor * bias      = pad->src[0];
+    const ggml_tensor * rcur      = mm->src[1];
+    const ggml_tensor * rel_pos   = get_rows->src[1];
+    const ggml_tensor * base_mask = add->src[1];
+
+    vk_pipeline pipeline = ctx->device->pipeline_rel_bias_mask_direct_f32_f16;
+    ggml_pipeline_request_descriptor_sets(ctx, pipeline, 1);
+
+    vk_subbuffer b_buf = ggml_vk_tensor_subbuffer(ctx, bias,      true);
+    vk_subbuffer r_buf = ggml_vk_tensor_subbuffer(ctx, rcur,      true);
+    vk_subbuffer p_buf = ggml_vk_tensor_subbuffer(ctx, rel_pos,   true);
+    vk_subbuffer m_buf = ggml_vk_tensor_subbuffer(ctx, base_mask, true);
+    vk_subbuffer d_buf = ggml_vk_tensor_subbuffer(ctx, dst,       true);
+
+    const uint32_t n_kv     = (uint32_t)dst->ne[0];
+    const uint32_t n_head   = (uint32_t)dst->ne[2];
+    const uint32_t n_rel    = (uint32_t)bias->ne[0];
+    const uint32_t n_extent = (uint32_t)bias->ne[1];
+    vk_op_rel_bias_mask_direct_push_constants pc {
+        n_kv, n_head, n_rel, n_extent,
+        (uint32_t)(get_misalign_bytes(ctx, bias)      / sizeof(float)),
+        (uint32_t)(get_misalign_bytes(ctx, rcur)      / sizeof(float)),
+        (uint32_t)(get_misalign_bytes(ctx, rel_pos)   / sizeof(int32_t)),
+        (uint32_t)(get_misalign_bytes(ctx, base_mask) / sizeof(float)),
+        (uint32_t)(get_misalign_bytes(ctx, dst)       / sizeof(ggml_fp16_t)),
+    };
