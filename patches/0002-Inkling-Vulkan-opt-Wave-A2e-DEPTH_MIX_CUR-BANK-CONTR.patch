+        msg->type != GGML_TYPE_F32 || !ggml_is_contiguous(msg) || !ggml_are_same_shape(cur, msg) ||
+        add->type != GGML_TYPE_F32 || !ggml_is_contiguous(add) || !ggml_are_same_shape(cur, add)) {
